-- SableUI v3.0 | client-side Roblox Luau
-- A standalone recreation of the supplied Sable interface.
-- Upload this file to a raw URL, then load it with:
-- local SableUI = loadstring(game:HttpGet("YOUR_RAW_LIBRARY_URL"))()
-- See SableUI_Example.lua for every control and the floating panels.
-- Custom font files are cached once. The library loads no external Lua code.

local Players = game:GetService("Players")
local Input = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local Library = { Version = "3.0.0", DefaultFont = "tahoma", FontBaseUrl = "https://raw.githubusercontent.com/sametexe001/luas/main/fonts/", AssetErrors = {} }
local bundledImages, imageCache = {}, {}
local Window = {}
local Tab = {}
local Section = {}
Window.__index = Window
Tab.__index = Tab
Section.__index = Section

local Theme = {
    Background = Color3.fromRGB(20, 18, 23),
    Header = Color3.fromRGB(29, 26, 33),
    Section = Color3.fromRGB(27, 24, 31),
    Control = Color3.fromRGB(22, 19, 25),
    Border = Color3.fromRGB(39, 35, 44),
    Text = Color3.fromRGB(221, 219, 226),
    Muted = Color3.fromRGB(137, 132, 144),
    Accent = Color3.fromRGB(144, 183, 222),
    Success = Color3.fromRGB(89, 230, 32),
}

-- Font = "tahoma" or Font = "RobotoMono-Regular" resolves a filename in FontBaseUrl.
-- Include .ttf/.otf if needed. Full URLs, Font objects and {Path=...} also work.
-- Other presets: Dear ImGui's bundled fonts (Roboto/Droid Sans: Apache 2.0;
-- Proggy Clean/Tiny: MIT). Custom paths and URLs can be supplied instead.
Library.Fonts = {
    Tahoma = { Name = "Tahoma", Url = "https://raw.githubusercontent.com/sametexe001/luas/main/fonts/tahoma.ttf" },
    RobotoMono = { Name = "RobotoMonoRegular", Url = "https://raw.githubusercontent.com/sametexe001/luas/main/fonts/RobotoMono-Regular.ttf", Weight = Enum.FontWeight.Regular },
    Roboto = { Name = "RobotoMedium", Url = "https://raw.githubusercontent.com/ocornut/imgui/master/misc/fonts/Roboto-Medium.ttf", Weight = Enum.FontWeight.Medium },
    DroidSans = { Name = "DroidSans", Url = "https://raw.githubusercontent.com/ocornut/imgui/master/misc/fonts/DroidSans.ttf" },
    ProggyClean = { Name = "ProggyClean", Url = "https://raw.githubusercontent.com/sametexe001/luas/main/fonts/ProggyClean.ttf" },
    ProggyTiny = { Name = "ProggyTiny", Url = "https://raw.githubusercontent.com/sametexe001/luas/main/fonts/proggy-tiny.ttf" },
}
local owners = setmetatable({}, { __mode = "k" })
local fallbackFont = Font.new("rbxasset://fonts/families/Roboto.json", Enum.FontWeight.Medium)

local function environment()
    local env = getfenv(0)
    local shared = type(env.getgenv) == "function" and env.getgenv() or env
    return setmetatable({}, { __index = function(_, key) return shared[key] or env[key] end })
end

local function resolveFont(spec)
    if spec == nil then spec = Library.DefaultFont end
    if typeof(spec) == "Font" then return spec end
    if typeof(spec) == "EnumItem" then return Font.fromEnum(spec) end
    if type(spec) == "string" then
        if Library.Fonts[spec] then spec = Library.Fonts[spec]
        elseif spec:match("^rbxasset") then return Font.new(spec)
        elseif spec:match("^https://") then spec = { Name = "Custom", Url = spec }
        elseif spec:find("/", 1, true) or spec:find("\\", 1, true) then spec = { Name = "Custom", Path = spec }
        else
            -- Accept the common Mono/Monto typo, while fetching the real filename.
            local filename = spec:gsub("^RobotoMonto%-Regular", "RobotoMono-Regular")
            assert(filename:match("^[%w _%.%-]+$") and not filename:find("..", 1, true), "Use a font filename, HTTPS URL, or {Path=...}")
            if not filename:lower():match("%.ttf$") and not filename:lower():match("%.otf$") then filename ..= ".ttf" end
            local encoded = filename:gsub("[^%w%-%._~]", function(character) return string.format("%%%02X", string.byte(character)) end)
            local bold = filename:lower():find("bold", 1, true) or filename:lower() == "tahomabd.ttf"
            spec = { Name = filename:gsub("%.[^%.]+$", ""), Url = Library.FontBaseUrl .. encoded, Weight = bold and Enum.FontWeight.Bold or Enum.FontWeight.Regular }
        end
    end
    assert(type(spec) == "table", "Font must be a preset, Font, family ID, or {Name, Url/Path}")
    if spec.Family then return Font.new(spec.Family, spec.Weight or Enum.FontWeight.Regular, spec.Style or Enum.FontStyle.Normal) end
    local env = environment()
    local asset = env.getcustomasset or env.getsynasset
    assert(type(asset) == "function" and type(env.writefile) == "function", "Custom TTF fonts require getcustomasset and writefile")
    local source = spec.Url or spec.Path
    assert(type(source) == "string" and #source > 0, "Custom font needs Url or Path")
    local hash = 5381
    for index = 1, #source do hash = (hash * 33 + source:byte(index)) % 2147483647 end
    local name = tostring(spec.Name or "Custom"):gsub("[^%w_-]", "")
    local base = "SableUI_font_" .. name .. "_" .. tostring(hash)
    local path = spec.Path or (base .. (source:lower():find(".otf", 1, true) and ".otf" or ".ttf"))
    if not spec.Path then
        assert(source:match("^https://"), "Font URLs must use HTTPS")
        local exists = type(env.isfile) == "function" and env.isfile(path)
        if not exists then
            local bytes = game:HttpGet(source)
            local magic = type(bytes) == "string" and bytes:sub(1, 4)
            assert(type(bytes) == "string" and #bytes >= 1024 and #bytes <= 8388608
                and (magic == "\0\1\0\0" or magic == "OTTO" or magic == "true" or magic == "ttcf"), "Font URL did not return a valid TTF/OTF file")
            env.writefile(path, bytes)
        end
    end
    local weight = spec.Weight or Enum.FontWeight.Regular
    local familyPath = base .. "_" .. tostring(weight.Value) .. ".font"
    env.writefile(familyPath, HttpService:JSONEncode({
        name = name,
        faces = { { name = "Regular", weight = weight.Value, style = "normal", assetId = asset(path) } },
    }))
    return Font.new(asset(familyPath), weight, Enum.FontStyle.Normal)
end

function Library:LoadFont(spec)
    local ok, result = pcall(resolveFont, spec)
    if ok then return result end
    return nil, tostring(result)
end

-- The mascot and soft halo are bundled PNGs; nothing else needs uploading.
-- Decode in small blocks, then cache once using the same executor API as fonts.
local function decodeBase64(encoded)
    encoded = encoded:gsub("%s", "")
    local alphabet, codes = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", {}
    for index = 1, #alphabet do codes[alphabet:byte(index)] = index - 1 end
    local chunks = {}
    for start = 1, #encoded, 4096 do
        local bytes = {}
        for index = start, math.min(start + 4095, #encoded), 4 do
            local a, b, c, d = encoded:byte(index, index + 3)
            local value = (codes[a] or 0) * 262144 + (codes[b] or 0) * 4096 + (codes[c] or 0) * 64 + (codes[d] or 0)
            local first, second, third = math.floor(value / 65536), math.floor(value / 256) % 256, value % 256
            bytes[#bytes + 1] = c == 61 and string.char(first) or d == 61 and string.char(first, second) or string.char(first, second, third)
        end
        chunks[#chunks + 1] = table.concat(bytes)
    end
    return table.concat(chunks)
end

local function bundledAsset(name)
    if imageCache[name] then return imageCache[name] end
    local ok, result = pcall(function()
        local env = environment()
        local asset = env.getcustomasset or env.getsynasset
        assert(type(asset) == "function" and type(env.writefile) == "function", "Bundled images require getcustomasset and writefile")
        local path = "SableUI_" .. name .. "_v3.png"
        if type(env.isfile) ~= "function" or not env.isfile(path) then env.writefile(path, decodeBase64(assert(bundledImages[name], "Missing bundled image"))) end
        return asset(path)
    end)
    if ok then imageCache[name] = result return result end
    Library.AssetErrors[name] = tostring(result)
    return ""
end

local function ownerOf(parent)
    while parent do
        if owners[parent] then return owners[parent] end
        parent = parent.Parent
    end
end

local function make(class, properties, parent)
    local object = Instance.new(class)
    for property, value in pairs(properties or {}) do
        object[property] = value
    end
    if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
        local window = ownerOf(parent)
        if window then
            local baseSize = object.TextSize
            local locked = properties and properties.Font ~= nil
            window._text[object] = { Size = baseSize, Locked = locked }
            if not locked then
                object.FontFace = window.FontFace
                object.TextSize = math.max(8, baseSize + window.TextSize - 14)
            end
        end
    end
    object.Parent = parent
    return object
end

local function corner(object, radius)
    return make("UICorner", { CornerRadius = UDim.new(0, radius or 3) }, object)
end

local function stroke(object, color, transparency)
    return make("UIStroke", {
        Color = color, Thickness = 1, Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, object)
end

local function softGlow(parent, color, spread, strength, filled)
    local root = make("Frame", { Name = "SoftGlow", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1 }, parent)
    local image = bundledAsset(filled and "shadow" or "halo")
    if image ~= "" then
        make("ImageLabel", {
            Name = "Halo", BackgroundTransparency = 1, Image = image, ImageColor3 = color,
            ImageTransparency = 1 - strength, ScaleType = Enum.ScaleType.Slice,
            SliceCenter = Rect.new(32, 32, 96, 96), SliceScale = spread / 32,
            Position = UDim2.fromOffset(-spread, -spread), Size = UDim2.new(1, spread * 2, 1, spread * 2),
        }, root)
    else
        for index = 12, 1, -1 do
            local distance = index * spread / 12
            local ring = make("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(-distance, -distance), Size = UDim2.new(1, distance * 2, 1, distance * 2) }, root)
            local outline = stroke(ring, color, 1 - strength * 0.3 * (1 - index / 13) ^ 2)
            outline.Thickness = math.max(1, spread / 12)
        end
    end
    return root
end

local function pad(object, amount)
    return make("UIPadding", {
        PaddingLeft = UDim.new(0, amount), PaddingRight = UDim.new(0, amount),
        PaddingTop = UDim.new(0, amount), PaddingBottom = UDim.new(0, amount),
    }, object)
end

local function stack(object, gap)
    return make("UIListLayout", {
        Padding = UDim.new(0, gap or 0), SortOrder = Enum.SortOrder.LayoutOrder,
    }, object)
end

local function label(parent, text, size, color, props)
    local properties = {
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = tostring(text or ""), TextSize = size or 14,
        TextColor3 = color or Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, 0, 0, 20), TextTruncate = Enum.TextTruncate.AtEnd,
    }
    for property, value in pairs(props or {}) do properties[property] = value end
    return make("TextLabel", properties, parent)
end

local function button(parent, text, props)
    local properties = {
        BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false,
        Text = text or "", TextSize = 14,
        TextColor3 = Theme.Text, Size = UDim2.fromScale(1, 1),
    }
    for property, value in pairs(props or {}) do properties[property] = value end
    return make("TextButton", properties, parent)
end

local function field(parent, text, props)
    local properties = {
        BackgroundColor3 = Theme.Control, BorderSizePixel = 0,
        TextSize = 13, TextColor3 = Theme.Text,
        PlaceholderColor3 = Theme.Muted, TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false, Text = tostring(text or ""),
        Size = UDim2.new(1, 0, 0, 25),
    }
    for property, value in pairs(props or {}) do properties[property] = value end
    local object = make("TextBox", properties, parent)
    corner(object, 2)
    make("UIPadding", { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7) }, object)
    return object
end

local function line(parent, startPoint, endPoint, color, thickness)
    local delta = endPoint - startPoint
    return make("Frame", {
        BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset((startPoint.X + endPoint.X) / 2, (startPoint.Y + endPoint.Y) / 2),
        Size = UDim2.fromOffset(delta.Magnitude, thickness or 1), Rotation = math.deg(math.atan2(delta.Y, delta.X)),
    }, parent)
end

local function drawIcon(parent, kind, color, position)
    local root = make("Frame", { Name = "Icon", BackgroundTransparency = 1, Position = position or UDim2.new(), Size = UDim2.fromOffset(14, 14) }, parent)
    if kind == "Chat" then
        corner(make("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, Position = UDim2.fromOffset(1, 2), Size = UDim2.fromOffset(10, 8) }, root), 2)
        make("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, Position = UDim2.fromOffset(3, 8), Size = UDim2.fromOffset(3, 3), Rotation = 45 }, root)
    elseif kind == "Settings" then
        for index = 0, 3 do
            make("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(7, 7), Size = UDim2.fromOffset(3, 13), Rotation = index * 45 }, root)
        end
        local ring = make("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, Position = UDim2.fromOffset(2, 2), Size = UDim2.fromOffset(10, 10) }, root)
        corner(ring, 5)
        local center = make("Frame", { BackgroundColor3 = Color3.fromRGB(26, 23, 30), BorderSizePixel = 0, Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(6, 6), Name = "Hole" }, root)
        corner(center, 3)
    else
        for index = 0, 2 do
            local ring = make("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(index * 2 + 1, index * 2 + 1), Size = UDim2.fromOffset(12 - index * 4, 12 - index * 4) }, root)
            corner(ring, 9)
            stroke(ring, color, 0.15 + index * 0.12)
        end
    end
    return root
end

local function pointer(input)
    return Vector2.new(input.Position.X, input.Position.Y)
end

local function isPointer(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function inside(object, point)
    if not object or not object.Parent or not object.Visible then return false end
    local p, s = object.AbsolutePosition, object.AbsoluteSize
    return point.X >= p.X and point.X <= p.X + s.X and point.Y >= p.Y and point.Y <= p.Y + s.Y
end

local function finite(value)
    return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function copy(value)
    return type(value) == "table" and table.clone(value) or value
end

local function keycode(value)
    if typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode then return value end
    if type(value) == "string" then
        local ok, key = pcall(function() return Enum.KeyCode[value] end)
        if ok then return key end
    end
    return nil
end

local function keyname(value)
    if not value or value == Enum.KeyCode.Unknown then return "_" end
    local names = { LeftControl = "LCtrl", RightControl = "RCtrl", LeftShift = "LShift", RightShift = "RShift" }
    return names[value.Name] or value.Name
end

local function call(callback, ...)
    if type(callback) ~= "function" then return end
    local ok, message = pcall(callback, ...)
    if not ok then warn("[SableUI] Callback: " .. tostring(message)) end
end

function Window:_connect(signal, callback)
    local connection = signal:Connect(callback)
    self._connections[#self._connections + 1] = connection
    return connection
end

function Window:_tween(object, properties, duration)
    local previous = self._tweens[object]
    if previous then previous:Cancel() end
    local tween = TweenService:Create(object, TweenInfo.new(duration or 0.14, Enum.EasingStyle.Quad), properties)
    self._tweens[object] = tween
    tween:Play()
    return tween
end

function Window:_accent(object, property)
    self._accents[object] = property
    object[property] = self.Theme.Accent
end

function Window:SetAccent(color)
    assert(typeof(color) == "Color3", "Accent must be a Color3")
    self.Theme.Accent = color
    for object, property in pairs(self._accents) do
        if object.Parent then object[property] = color end
    end
    for _, tab in ipairs(self.Tabs) do tab:_paint() end
    for _, control in ipairs(self.Controls) do
        if control._paint then control:_paint() end
    end
end

function Window:SetFont(spec)
    local face, message = Library:LoadFont(spec)
    if not face then return false, message end
    self.FontFace, self.FontError = face, nil
    for object, settings in pairs(self._text) do
        if object.Parent and not settings.Locked then object.FontFace = face end
    end
    return true
end

function Window:SetTextSize(size)
    assert(type(size) == "number" and size >= 8 and size <= 20, "Text size must be between 8 and 20")
    self.TextSize = size
    for object, settings in pairs(self._text) do
        if object.Parent and not settings.Locked then object.TextSize = math.max(8, settings.Size + size - 14) end
    end
end

function Window:_bounds()
    local camera = workspace.CurrentCamera
    if not camera then return 0, 0, self._size.X, self._size.Y end
    local origin, viewport, scale = self.Stage.AbsolutePosition, camera.ViewportSize, math.max(0.1, self.Scale.Scale)
    return (8 - origin.X) / scale, (8 - origin.Y) / scale, (viewport.X - 8 - origin.X) / scale, (viewport.Y - 8 - origin.Y) / scale
end

function Window:_bringToFront(target)
    for frame in pairs(self._positions) do if frame.Parent then frame.ZIndex = frame == target and 20 or 10 end end
    if self.Mascot then self.Mascot.ZIndex = self.Frame.ZIndex + 1 end
end

function Window:_drag(handle, target)
    handle.Active = true
    self:_connect(handle.InputBegan, function(input)
        if not isPointer(input) or self._dead or self._resizingInput == input then return end
        self:_closePopup()
        self:_bringToFront(target)
        local start, position = pointer(input), target.Position
        self._dragging = { Input = input, Update = function(point)
            local delta = (point - start) / self.Scale.Scale
            local left, top, right, bottom = self:_bounds()
            local x = math.clamp(position.X.Offset + delta.X, left, math.max(left, right - target.Size.X.Offset))
            local y = math.clamp(position.Y.Offset + delta.Y, top, math.max(top, bottom - target.Size.Y.Offset))
            target.Position = UDim2.fromOffset(x, y)
        end }
    end)
end

function Window:_enableResize(target, options)
    options = options or {}
    local window = self
    local minimum = options.MinSize or Vector2.new(180, 190)
    local maximum = options.MaxSize or Vector2.new(900, 700)
    local controller = { Enabled = options.Enabled ~= false, Handles = {}, MinSize = minimum, MaxSize = maximum }
    self._sizes[target] = target.Size
    self._resizers[target] = controller
    function controller:SetEnabled(enabled)
        self.Enabled = enabled == true
        for _, handle in ipairs(self.Handles) do handle.Visible = self.Enabled end
    end
    function controller:SetSize(width, height)
        if typeof(width) == "Vector2" then width, height = width.X, width.Y end
        assert(finite(width) and finite(height), "Size must contain finite width and height")
        local _, _, right, bottom = window:_bounds()
        local available = Vector2.new(right - target.Position.X.Offset, bottom - target.Position.Y.Offset)
        target.Size = UDim2.fromOffset(math.clamp(width, minimum.X, math.max(minimum.X, math.min(maximum.X, available.X))), math.clamp(height, minimum.Y, math.max(minimum.Y, math.min(maximum.Y, available.Y))))
    end
    for _, definition in ipairs({ { "TopLeft", -1, -1 }, { "TopRight", 1, -1 }, { "BottomLeft", -1, 1 }, { "BottomRight", 1, 1 } }) do
        local name, horizontal, vertical = definition[1], definition[2], definition[3]
        local handle = button(target, "", {
            Name = "Resize" .. name, Active = true, Visible = controller.Enabled,
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(horizontal == 1 and 1 or 0, vertical == 1 and 1 or 0),
            Size = UDim2.fromOffset(24, 24), ZIndex = 60,
        })
        local a = line(handle, Vector2.new(12 - horizontal * 7, 12 - vertical * 2), Vector2.new(12 - horizontal * 2, 12 - vertical * 2), self.Theme.Muted)
        local b = line(handle, Vector2.new(12 - horizontal * 2, 12 - vertical * 7), Vector2.new(12 - horizontal * 2, 12 - vertical * 2), self.Theme.Muted)
        a.BackgroundTransparency, b.BackgroundTransparency = 0.7, 0.7
        local function paint(active)
            window:_tween(a, { BackgroundTransparency = active and 0.05 or 0.7, BackgroundColor3 = active and window.Theme.Accent or window.Theme.Muted })
            window:_tween(b, { BackgroundTransparency = active and 0.05 or 0.7, BackgroundColor3 = active and window.Theme.Accent or window.Theme.Muted })
        end
        self:_connect(handle.MouseEnter, function() paint(true) end)
        self:_connect(handle.MouseLeave, function() if window._resizingInput == nil then paint(false) end end)
        self:_connect(handle.InputBegan, function(input)
            if not controller.Enabled or not isPointer(input) or window._dead then return end
            window:_closePopup()
            window:_bringToFront(target)
            local start, position, size = pointer(input), target.Position, target.Size
            local fixedX = position.X.Offset + (horizontal == -1 and size.X.Offset or 0)
            local fixedY = position.Y.Offset + (vertical == -1 and size.Y.Offset or 0)
            window._resizingInput = input
            paint(true)
            window._dragging = { Input = input, Finish = function() paint(false) end, Update = function(point)
                local delta = (point - start) / window.Scale.Scale
                local left, top, right, bottom = window:_bounds()
                local maxWidth = math.max(minimum.X, math.min(maximum.X, horizontal == -1 and fixedX - left or right - fixedX))
                local maxHeight = math.max(minimum.Y, math.min(maximum.Y, vertical == -1 and fixedY - top or bottom - fixedY))
                local width = math.clamp(size.X.Offset + delta.X * horizontal, minimum.X, maxWidth)
                local height = math.clamp(size.Y.Offset + delta.Y * vertical, minimum.Y, maxHeight)
                target.Position = UDim2.fromOffset(horizontal == -1 and fixedX - width or fixedX, vertical == -1 and fixedY - height or fixedY)
                target.Size = UDim2.fromOffset(math.round(width), math.round(height))
            end }
        end)
        controller.Handles[#controller.Handles + 1] = handle
    end
    return controller
end

function Window:_track(handle, callback)
    self:_connect(handle.InputBegan, function(input)
        if not isPointer(input) then return end
        self._dragging = { Input = input, Update = callback }
        callback(pointer(input))
    end)
end

function Window:_surface(name, title, position, size)
    local shell = make("Frame", {
        Name = name, Position = position, Size = size, BackgroundTransparency = 1,
    }, self.Stage)
    local shadow = softGlow(shell, Color3.new(0, 0, 0), 18, 0.85, true)
    shadow.Position = UDim2.fromOffset(0, 4)
    local body = make("Frame", {
        Name = "Body", BackgroundColor3 = self.Theme.Background, BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1), ZIndex = 2, Active = true,
    }, shell)
    corner(body, 3)
    stroke(body, self.Theme.Border, 0.35)
    local header = make("Frame", {
        Name = "Header", BackgroundColor3 = self.Theme.Header, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 28),
    }, body)
    corner(header, 3)
    make("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(225, 225, 225)) }, header)
    make("Frame", {
        BackgroundColor3 = self.Theme.Header, BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(1, 0, 0, 4),
    }, header)
    local heading = label(header, title, 14, self.Theme.Text, {
        Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0),
    })
    self:_drag(header, shell)
    self._positions[shell] = position
    return shell, body, header, heading
end

function Window:_closePopup()
    if self._popup then
        self._popup.Frame.Visible = false
        self._popup = nil
    end
end

function Window:_placePopup(popup, anchor)
    local scale = self.Scale.Scale
    local at = (anchor.AbsolutePosition - self.Stage.AbsolutePosition) / scale
    local below = at.Y + anchor.AbsoluteSize.Y / scale + 5
    local width, height = popup.Size.X.Offset, popup.Size.Y.Offset
    local x = math.clamp(at.X, 4, math.max(4, self.Stage.Size.X.Offset - width - 4))
    if below + height > self.Stage.Size.Y.Offset - 4 then below = at.Y - height - 5 end
    popup.Position = UDim2.fromOffset(x, math.max(4, below))
end

function Window:_openPopup(popup, anchor)
    if self._popup and self._popup.Frame == popup then self:_closePopup() return end
    self:_closePopup()
    self:_placePopup(popup, anchor)
    self._popup = { Frame = popup, Anchor = anchor }
    popup.Visible = true
end

function Window:_popupFrame(width, height)
    local frame = make("Frame", {
        Name = "Popup", Visible = false, Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = self.Theme.Header, BorderSizePixel = 0, ZIndex = 50, Active = true,
    }, self.Stage)
    softGlow(frame, Color3.new(0, 0, 0), 12, 0.9).ZIndex = 0
    corner(frame, 3)
    stroke(frame, self.Theme.Border)
    return frame
end

function Library:CreateWindow(options)
    options = options or {}
    assert(RunService:IsClient(), "SableUI must run inside the Roblox client.")
    local parent = options.Parent or Players.LocalPlayer:WaitForChild("PlayerGui")
    local id = options.Id or "SableUI"
    local previous = parent:FindFirstChild(id)
    if previous and previous:IsA("ScreenGui") then previous:Destroy() end
    local self = setmetatable({
        Theme = table.clone(Theme), Tabs = {}, Controls = {}, Flags = {},
        _connections = {}, _accents = setmetatable({}, { __mode = "k" }),
        _text = setmetatable({}, { __mode = "k" }),
        _tweens = setmetatable({}, { __mode = "k" }), _positions = {}, _sizes = {}, _resizers = {}, _byFlag = {},
        _bindings = {}, _rainbows = {}, _notices = {}, _dead = false,
        ToggleKey = keycode(options.ToggleKey) or Enum.KeyCode.RightShift,
        _elapsed = 0, _frames = 0, _time = 0, _size = Vector2.new(1104, 500),
        TextSize = options.TextSize or 11,
    }, Window)
    for name, value in pairs(options.Theme or {}) do
        if self.Theme[name] and typeof(value) == "Color3" then self.Theme[name] = value end
    end
    if options.Accent then self.Theme.Accent = options.Accent end
    local font, fontError = Library:LoadFont(options.Font or Library.DefaultFont)
    self.FontFace, self.FontError = font or fallbackFont, fontError
    self.Gui = make("ScreenGui", {
        Name = id, ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = options.DisplayOrder or 40,
    }, parent)
    owners[self.Gui] = self
    self.Stage = make("Frame", {
        Name = "Workspace", AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(1104, 500),
        BackgroundTransparency = 1, BorderSizePixel = 0,
    }, self.Gui)
    self.Scale = make("UIScale", { Scale = 1 }, self.Stage)
    self._userScale = options.Scale or 1
    local surface, body, header, title = self:_surface("Window", "", UDim2.fromOffset(302, 60), UDim2.fromOffset(470, 424))
    self.Frame, self.Body = surface, body
    header.Size = UDim2.new(1, 0, 0, 44)
    local logo = label(header, "S", 27, self.Theme.Accent, {
        Position = UDim2.fromOffset(12, 2), Size = UDim2.fromOffset(23, 38), Font = Enum.Font.Garamond,
    })
    self:_accent(logo, "TextColor3")
    title.Text = options.Title or "Sable"
    title.Position = UDim2.fromOffset(42, 7)
    title.Size = UDim2.new(1, -105, 0, 14)
    self:_accent(title, "TextColor3")
    self.Subtitle = label(header, options.Subtitle or "Expires: Never", 13, self.Theme.Muted, {
        Position = UDim2.fromOffset(42, 22), Size = UDim2.new(1, -105, 0, 13),
    })
    local minimize = button(header, "−", { Visible = options.WindowButtons == true, Position = UDim2.new(1, -55, 0, 11), Size = UDim2.fromOffset(22, 22), TextColor3 = self.Theme.Muted })
    local close = button(header, "×", { Visible = options.WindowButtons == true, Position = UDim2.new(1, -29, 0, 11), Size = UDim2.fromOffset(22, 22), TextColor3 = self.Theme.Muted })
    self:_connect(minimize.Activated, function() self:Toggle() end)
    self:_connect(close.Activated, function() self:Toggle() end)
    self.TabBar = make("ScrollingFrame", {
        BackgroundColor3 = Color3.fromRGB(26, 23, 30), BackgroundTransparency = 0.15, BorderSizePixel = 0, Position = UDim2.fromOffset(12, 54),
        Size = UDim2.fromOffset(0, 29), CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollBarThickness = 0,
        ScrollingDirection = Enum.ScrollingDirection.X,
    }, body)
    make("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.TabBar)
    corner(self.TabBar, 2)
    self.Resizer = self:_enableResize(surface, { Enabled = options.Resizable ~= false, MinSize = Vector2.new(430, 360), MaxSize = Vector2.new(960, 720) })
    self:_connect(surface:GetPropertyChangedSignal("Size"), function() self:_fitTabs() end)
    self.Pages = make("Frame", {
        Name = "Pages", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 95),
        Size = UDim2.new(1, -34, 1, -105), ClipsDescendants = true,
    }, body)
    self.Notifications = make("Frame", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 220),
        Size = UDim2.fromOffset(195, 100), ZIndex = 70,
    }, self.Stage)
    stack(self.Notifications, 7).VerticalAlignment = Enum.VerticalAlignment.Bottom
    self.Reopen = button(self.Gui, (options.Title or "Sable") .. "  ·  Open", {
        Visible = false, BackgroundColor3 = self.Theme.Header, TextColor3 = self.Theme.Accent,
        Position = UDim2.new(0, 12, 0.5, -17), Size = UDim2.fromOffset(112, 34),
    })
    corner(self.Reopen, 4)
    stroke(self.Reopen, self.Theme.Border)
    self:_connect(self.Reopen.Activated, function() self:SetVisible(true) end)
    if options.Mascot ~= false then
        local mascotImage = options.MascotImage and options.MascotImage ~= "" and options.MascotImage or bundledAsset("mascot")
        self.Mascot = make("ImageLabel", {
            Name = "Mascot", BackgroundTransparency = 1, Image = mascotImage, Active = false,
            ScaleType = Enum.ScaleType.Fit, Size = UDim2.fromOffset(176, 200), ZIndex = 35,
        }, self.Stage)
        local function followWindow()
            self.Mascot.Position = UDim2.fromOffset(surface.Position.X.Offset + surface.Size.X.Offset - 154, surface.Position.Y.Offset - 54)
        end
        self:_connect(surface:GetPropertyChangedSignal("Position"), followWindow)
        self:_connect(surface:GetPropertyChangedSignal("Size"), followWindow)
        followWindow()
    end
    self:_connect(Input.InputBegan, function(input, processed)
        if self._dead then return end
        if self._capturing then
            local binding = self._capturing
            if input.UserInputType == Enum.UserInputType.Keyboard then
                self._capturing = nil
                if input.KeyCode == Enum.KeyCode.Escape then binding:_paint()
                elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then binding:Set(Enum.KeyCode.Unknown)
                else binding:Set(input.KeyCode) end
            end
            return
        end
        if isPointer(input) and self._popup and not inside(self._popup.Frame, pointer(input)) and not inside(self._popup.Anchor, pointer(input)) then
            self:_closePopup()
        end
        if processed or Input:GetFocusedTextBox() then return end
        if input.KeyCode == self.ToggleKey then self:Toggle() return end
        for _, binding in ipairs(self._bindings) do
            if not binding.Disabled and not (binding.Target and binding.Target.Disabled) and binding.Value ~= Enum.KeyCode.Unknown and input.KeyCode == binding.Value then
                if binding.Mode == "Hold" then binding.Active = true
                elseif binding.Mode == "Toggle" then binding.Active = not binding.Active end
                if binding.Target then binding.Target:Set(not binding.Target.Value) end
                call(binding.Callback, binding.Mode == "Press" or binding.Active, binding.Value)
                self:_refreshKeybinds()
            end
        end
    end)
    self:_connect(Input.InputChanged, function(input)
        local drag = self._dragging
        if drag and (input == drag.Input or (drag.Input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then
            drag.Update(pointer(input))
        end
    end)
    self:_connect(Input.InputEnded, function(input)
        local drag = self._dragging
        if drag and (input == drag.Input or input.UserInputType == Enum.UserInputType.MouseButton1) then
            if drag.Finish then drag.Finish() end
            self._dragging, self._resizingInput = nil, nil
        end
        for _, binding in ipairs(self._bindings) do
            if binding.Mode == "Hold" and binding.Active and input.KeyCode == binding.Value then
                binding.Active = false
                call(binding.Callback, false, binding.Value)
                self:_refreshKeybinds()
            end
        end
    end)
    self:_connect(Input.WindowFocusReleased, function()
        if self._dragging and self._dragging.Finish then self._dragging.Finish() end
        self._dragging, self._resizingInput = nil, nil
        for _, binding in ipairs(self._bindings) do
            if binding.Mode == "Hold" and binding.Active then binding.Active = false call(binding.Callback, false, binding.Value) end
        end
        self:_refreshKeybinds()
    end)
    self:_connect(RunService.RenderStepped, function(dt)
        self._elapsed += dt
        self._frames += 1
        self._time += dt
        if self.Preview then self.Preview:_step(dt) end
        local camera = workspace.CurrentCamera
        if camera then
            local viewport = camera.ViewportSize
            local scale = math.min((viewport.X - 16) / self._size.X, (viewport.Y - 16) / self._size.Y, self._userScale)
            self.Scale.Scale = math.max(0.1, scale)
        end
        if self._elapsed >= 0.5 then
            self.FPS = math.floor(self._frames / self._elapsed + 0.5)
            self._frames, self._elapsed = 0, 0
            if self.Watermark then self.Watermark:_update() end
        end
        -- One shared clock; no threads or connections are created per update.
        if self._time >= 1 / 30 then
            self._time = 0
            for control in pairs(self._rainbows) do control:_rainbowStep() end
        end
        for index = #self._notices, 1, -1 do
            local notice = self._notices[index]
            notice.Time -= dt
            if notice.Time <= 0 then
                self._tweens[notice.Frame] = nil
                notice.Frame:Destroy()
                table.remove(self._notices, index)
            elseif notice.Time < 0.3 and not notice.Fading then
                notice.Fading = true
                self:_tween(notice.Frame, { GroupTransparency = 1 }, 0.25)
            end
        end
    end)
    self:_connect(self.Gui.Destroying, function() self:_cleanup() end)
    return self
end

function Window:SetVisible(visible)
    visible = visible == true
    self.Stage.Visible = visible
    self.Reopen.Visible = not visible
    if self._dragging and self._dragging.Finish then self._dragging.Finish() end
    self._dragging, self._resizingInput = nil, nil
    self:_closePopup()
end

function Window:Toggle() self:SetVisible(not self.Stage.Visible) end
function Window:SetSubtitle(text) self.Subtitle.Text = tostring(text) end
function Window:SetScale(scale) assert(finite(scale) and scale > 0, "Scale must be positive") self._userScale = math.clamp(scale, 0.4, 2) end

function Window:ResetPositions()
    self:_closePopup()
    for object, position in pairs(self._positions) do if object.Parent then object.Position = position end end
    for object, size in pairs(self._sizes) do if object.Parent then object.Size = size end end
end

function Window:SetSize(width, height) self.Resizer:SetSize(width, height) end
function Window:SetResizable(enabled) self.Resizer:SetEnabled(enabled) end
function Window:_fitTabs()
    local width = 0
    for _, tab in ipairs(self.Tabs) do if not tab.Hidden then width += tab.Button.Size.X.Offset end end
    self.TabBar.Size = UDim2.fromOffset(math.min(width, self.Frame.Size.X.Offset - 24), 29)
end

function Window:_cleanup()
    if self._dead then return end
    self._dead = true
    if self.Preview then self.Preview:_cleanup() end
    owners[self.Gui] = nil
    for _, connection in ipairs(self._connections) do connection:Disconnect() end
    for _, tween in pairs(self._tweens) do tween:Cancel() end
    for _, binding in ipairs(self._bindings) do
        if binding.Mode == "Hold" and binding.Active then call(binding.Callback, false, binding.Value) end
    end
    table.clear(self._connections)
    table.clear(self._rainbows)
    table.clear(self._notices)
    table.clear(self._bindings)
    table.clear(self._tweens)
    table.clear(self._accents)
    table.clear(self._text)
    table.clear(self._positions)
    table.clear(self._sizes)
    table.clear(self._resizers)
    table.clear(self._byFlag)
    table.clear(self.Flags)
    table.clear(self.Controls)
    table.clear(self.Tabs)
    self._dragging, self._popup, self._capturing, self._resizingInput = nil, nil, nil, nil
end

function Window:Destroy()
    self:_cleanup()
    if self.Gui then self.Gui:Destroy() end
end

function Window:Tab(options)
    options = type(options) == "string" and { Name = options } or options or {}
    local tab = setmetatable({ Window = self, Name = options.Name or "Tab", Hidden = options.Hidden == true }, Tab)
    tab.Button = button(self.TabBar, "", {
        Size = UDim2.fromOffset(options.Width or 75, 29), Visible = not tab.Hidden,
        LayoutOrder = #self.Tabs + 1,
    })
    tab.Selection = make("Frame", {
        Name = "Selection", BackgroundColor3 = Color3.fromRGB(37, 33, 42), BackgroundTransparency = 1,
        BorderSizePixel = 0, Position = UDim2.fromOffset(1, 1), Size = UDim2.new(1, -2, 1, -2),
    }, tab.Button)
    corner(tab.Selection, 2)
    make("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.05, 0.5) }, tab.Selection)
    tab.Icon = drawIcon(tab.Button, options.Icon or "Circle", self.Theme.Muted, UDim2.fromOffset(7, 7))
    tab.Title = label(tab.Button, tab.Name, 14, self.Theme.Muted, { Position = UDim2.fromOffset(27, 0), Size = UDim2.new(1, -29, 1, 0) })
    tab.Page = make("ScrollingFrame", {
        Name = tab.Name, BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
        Size = UDim2.fromScale(1, 1), ScrollBarThickness = 2, ScrollBarImageColor3 = self.Theme.Accent,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
    }, self.Pages)
    tab.Columns = {}
    self:_connect(tab.Page:GetPropertyChangedSignal("CanvasPosition"), function() self:_closePopup() end)
    for index, side in ipairs({ "Left", "Right" }) do
        local column = make("Frame", {
            Name = side, BackgroundTransparency = 1, Size = UDim2.new(0.5, -6, 0, 0),
            Position = UDim2.new((index - 1) * 0.5, index == 1 and 0 or 6, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
        }, tab.Page)
        stack(column, 10)
        tab.Columns[side] = column
    end
    self.Tabs[#self.Tabs + 1] = tab
    self:_fitTabs()
    self:_connect(tab.Button.Activated, function() self:SelectTab(tab) end)
    self:_connect(tab.Button.MouseEnter, function() tab.Hovered = true tab:_paint() end)
    self:_connect(tab.Button.MouseLeave, function() tab.Hovered = false tab:_paint() end)
    if not self.SelectedTab and not tab.Hidden then self:SelectTab(tab) end
    return tab
end

function Tab:_paint()
    local selected = self.Window.SelectedTab == self
    self.Button.BackgroundTransparency = 1
    self.Window:_tween(self.Selection, { BackgroundTransparency = selected and 0.1 or self.Hovered and 0.65 or 1 }, 0.12)
    self.Title.TextColor3 = selected and self.Window.Theme.Text or self.Window.Theme.Muted
    local iconColor = selected and self.Window.Theme.Accent or self.Window.Theme.Muted
    for _, object in ipairs(self.Icon:GetDescendants()) do
        if object:IsA("UIStroke") then object.Color = iconColor
        elseif object:IsA("Frame") and object.Name ~= "Hole" and object.BackgroundTransparency ~= 1 then object.BackgroundColor3 = iconColor end
    end
    self.Page.Visible = selected
end

function Tab:SetHidden(hidden) self.Hidden = hidden == true self.Button.Visible = not self.Hidden self.Window:_fitTabs() end

function Window:SelectTab(tab)
    if type(tab) == "number" then tab = self.Tabs[tab] end
    if type(tab) == "string" then
        for _, candidate in ipairs(self.Tabs) do if candidate.Name == tab then tab = candidate break end end
    end
    assert(type(tab) == "table" and tab.Window == self, "SelectTab expects a tab from this window")
    self:_closePopup()
    self.SelectedTab = tab
    for _, candidate in ipairs(self.Tabs) do candidate:_paint() end
end

function Tab:Section(options)
    options = type(options) == "string" and { Name = options } or options or {}
    local section = setmetatable({ Window = self.Window, Tab = self, _order = 0 }, Section)
    local column = self.Columns[options.Side or "Left"]
    assert(column, "Section.Side must be Left or Right")
    section.Frame = make("Frame", {
        Name = options.Name or "Section", BackgroundColor3 = self.Window.Theme.Section,
        BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = #column:GetChildren(),
    }, column)
    corner(section.Frame, 3)
    stroke(section.Frame, self.Window.Theme.Border, 0.65)
    pad(section.Frame, 10)
    stack(section.Frame, 3)
    label(section.Frame, options.Name or "Section", 14, self.Window.Theme.Text, { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 19) })
    return section
end

function Section:_row(height)
    self._order += 1
    return make("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height), LayoutOrder = self._order,
    }, self.Frame)
end

function Section:_control(options, kind, row)
    local window = self.Window
    local control = { Window = window, Frame = row, Type = kind, Flag = options.Flag, Callback = options.Callback, Disabled = options.Disabled == true }
    if control.Flag then
        assert(type(control.Flag) == "string" and not window._byFlag[control.Flag], "Flags must be unique strings: " .. tostring(control.Flag))
        window._byFlag[control.Flag] = control
    end
    function control:_publish(silent)
        if self.Flag then window.Flags[self.Flag] = copy(self.Value) end
        if not silent then call(self.Callback, copy(self.Value)) end
    end
    function control:Get() return copy(self.Value) end
    function control:SetVisible(value) row.Visible = value == true window:_closePopup() end
    function control:SetDisabled(value)
        self.Disabled = value == true
        if self._paint then self:_paint() end
    end
    window.Controls[#window.Controls + 1] = control
    return control
end

function Section:Label(text)
    local row = self:_row(0)
    row.AutomaticSize = Enum.AutomaticSize.Y
    local textLabel = label(row, text, 13, self.Window.Theme.Text, {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        TextWrapped = true, TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top,
    })
    return { Frame = row, Set = function(_, value) textLabel.Text = tostring(value) end, SetVisible = function(_, value) row.Visible = value == true end }
end

function Section:Divider(text)
    local row = self:_row(text and 22 or 7)
    make("Frame", { BorderSizePixel = 0, BackgroundColor3 = self.Window.Theme.Border, Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -2) }, row)
    if text then label(row, text, 12, self.Window.Theme.Muted) end
    return row
end

function Section:Button(options)
    options = type(options) == "string" and { Name = options } or options or {}
    local row = self:_row(27)
    local control = self:_control(options, "Button", row)
    local click = button(row, options.Name or "Button", { BackgroundTransparency = 0, BackgroundColor3 = self.Window.Theme.Control })
    corner(click, 3)
    stroke(click, self.Window.Theme.Border, 0.4)
    self.Window:_connect(click.Activated, function() if not control.Disabled then call(options.Callback) end end)
    self.Window:_connect(click.MouseEnter, function() if not control.Disabled then self.Window:_tween(click, { BackgroundColor3 = self.Window.Theme.Header }) end end)
    self.Window:_connect(click.MouseLeave, function() self.Window:_tween(click, { BackgroundColor3 = self.Window.Theme.Control }) end)
    function control:SetText(text) click.Text = tostring(text) end
    function control:_paint() click.TextTransparency = self.Disabled and 0.55 or 0 end
    control:_paint()
    return control
end

function Section:Toggle(options)
    options = options or {}
    local row = self:_row(17)
    local window = self.Window
    local control = self:_control(options, "Toggle", row)
    local hit = button(row, "", { Size = UDim2.new(1, options.Keybind and -50 or 0, 1, 0) })
    local box = make("Frame", { BorderSizePixel = 0, Position = UDim2.fromOffset(0, 2), Size = UDim2.fromOffset(13, 13) }, hit)
    corner(box, 2)
    local outline = stroke(box, window.Theme.Border, 0.3)
    local check = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, box)
    line(check, Vector2.new(3, 7), Vector2.new(5, 9), window.Theme.Background, 1.5)
    line(check, Vector2.new(5, 9), Vector2.new(10, 4), window.Theme.Background, 1.5)
    local title = label(hit, options.Name or "Toggle", 14, window.Theme.Text, { Position = UDim2.fromOffset(21, 0), Size = UDim2.new(1, -21, 1, 0) })
    function control:_paint()
        box.BackgroundColor3 = self.Value and window.Theme.Accent or window.Theme.Control
        outline.Color = self.Value and window.Theme.Accent or window.Theme.Border
        check.Visible = self.Value == true
        box.BackgroundTransparency = self.Disabled and 0.5 or 0
        title.TextTransparency = self.Disabled and 0.55 or 0
    end
    function control:Set(value, silent)
        assert(type(value) == "boolean", "Toggle:Set expects a boolean")
        self.Value = value
        self:_paint()
        self:_publish(silent)
        window:_refreshKeybinds()
    end
    window:_connect(hit.Activated, function() if not control.Disabled then control:Set(not control.Value) end end)
    control:Set(options.Default == true, true)
    if options.Keybind then
        control.Keybind = window:_binding(row, { Name = options.Name, Default = options.Keybind, Mode = "Toggle", Flag = options.KeybindFlag }, control)
    end
    return control
end

function Section:Slider(options)
    options = options or {}
    local window = self.Window
    local minimum, maximum, step = options.Min or 0, options.Max or 100, options.Step or 1
    assert(finite(minimum) and finite(maximum) and maximum > minimum, "Slider Max must exceed Min")
    assert(finite(step) and step > 0, "Slider Step must be positive")
    local row = self:_row(28)
    local control = self:_control(options, "Slider", row)
    control.Min, control.Max, control.Step = minimum, maximum, step
    local title = label(row, options.Name or "Slider", 14, window.Theme.Text, { Size = UDim2.new(0.6, 0, 0, 19) })
    local valueBox = field(row, "", { BackgroundTransparency = 1, Position = UDim2.new(0.6, 0, 0, 0), Size = UDim2.new(0.4, 0, 0, 19), TextXAlignment = Enum.TextXAlignment.Right })
    local hit = button(row, "", { Position = UDim2.fromOffset(0, 17), Size = UDim2.new(1, 0, 0, 13) })
    local track = make("Frame", { BackgroundColor3 = window.Theme.Control, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 5), Size = UDim2.new(1, 0, 0, 4) }, hit)
    corner(track, 3)
    local fill = make("Frame", { BackgroundColor3 = window.Theme.Accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, track)
    corner(fill, 3)
    window:_accent(fill, "BackgroundColor3")
    local knob = make("Frame", { BackgroundColor3 = window.Theme.Text, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), Position = UDim2.fromScale(0, 0.5) }, track)
    corner(knob, 5)
    local decimals = 0
    while decimals < 6 and math.abs(step * 10 ^ decimals - math.round(step * 10 ^ decimals)) > 0.000001 do decimals += 1 end
    function control:_paint()
        local fraction = (self.Value - minimum) / (maximum - minimum)
        fill.Size = UDim2.fromScale(fraction, 1)
        knob.Position = UDim2.fromScale(fraction, 0.5)
        valueBox.Text = options.Format and tostring(options.Format(self.Value)) or (string.format("%." .. decimals .. "f", self.Value) .. (options.Suffix or ""))
        title.TextTransparency = self.Disabled and 0.55 or 0
        valueBox.TextEditable = not self.Disabled
    end
    function control:Set(value, silent)
        assert(finite(value), "Slider:Set expects a finite number")
        self.Value = math.clamp(minimum + math.round((value - minimum) / step) * step, minimum, maximum)
        self:_paint()
        self:_publish(silent)
    end
    window:_track(hit, function(point)
        if control.Disabled then return end
        local fraction = math.clamp((point.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        control:Set(minimum + (maximum - minimum) * fraction)
    end)
    window:_connect(valueBox.Focused, function() if not control.Disabled then valueBox.Text = tostring(control.Value) end end)
    window:_connect(valueBox.FocusLost, function()
        local value = tonumber(valueBox.Text)
        if not control.Disabled and finite(value) then control:Set(value) else control:_paint() end
    end)
    control:Set(options.Default or minimum, true)
    return control
end

