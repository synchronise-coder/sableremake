    function widget:SetDistance(text) distance.Text = tostring(text) end
    function widget:SetWeapon(text) weapon.Text = tostring(text) end
    function widget:SetHealth(value)
        assert(finite(value), "Health must be a number")
        value = math.clamp(value, 0, 100)
        health.Text = tostring(math.round(value))
        healthFill.Size = UDim2.fromScale(1, value / 100)
    end
    function widget:SetColor(color)
        box:FindFirstChildOfClass("UIStroke").Color = color
        name.TextColor3 = color
    end
    function widget:SetModel(model)
        assert(typeof(model) == "Instance" and model:IsA("Model"), "SetModel expects a Model")
        if not model.Archivable then return false, "Model.Archivable must be true" end
        local ok, clone = pcall(function() return model:Clone() end)
        if not ok or not clone then return false, "Could not clone model" end
        for _, descendant in ipairs(clone:GetDescendants()) do
            if descendant:IsA("BaseScript") or descendant:IsA("ModuleScript") then descendant:Destroy()
            elseif descendant:IsA("BasePart") then descendant.Anchored = true descendant.CanCollide = false end
        end
        if self.Model then self.Model:Destroy() end
        clone.Parent = world
        clone:PivotTo(CFrame.new())
        local bounds, size = clone:GetBoundingBox()
        local center = bounds.Position
        local range = math.max(size.X, size.Y, size.Z) * 1.9
        camera.CFrame = CFrame.lookAt(center + Vector3.new(0, 0, range), center)
        self.Model = clone
        return true
    end
    widget:SetHealth(options.Health or 100)
    self.Preview = widget
    return widget
end

-- Configs contain data only. Import validates everything before changing controls.
function Window:ExportConfig()
    local values = {}
    for flag, control in pairs(self._byFlag) do
        if control.Type == "Colorpicker" then
            values[flag] = { Type = control.Type, Value = control.Value:ToHex(), Alpha = control.Alpha, Rainbow = control.Rainbow }
        elseif control.Type == "Keybind" then
            values[flag] = { Type = control.Type, Value = control.Value.Name }
        elseif control.Type ~= "Button" then
            values[flag] = { Type = control.Type, Value = copy(control.Value) }
        end
    end
    return HttpService:JSONEncode({ Version = 1, Values = values })
end

function Window:ImportConfig(json, silent)
    if type(json) ~= "string" or #json > 1024 * 1024 then return false, "Config must be JSON under 1 MB" end
    local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(data) ~= "table" or data.Version ~= 1 or type(data.Values) ~= "table" then return false, "Invalid SableUI config" end
    local changes = {}
    for flag, entry in pairs(data.Values) do
        local control = self._byFlag[flag]
        if control then
            if type(entry) ~= "table" or entry.Type ~= control.Type then return false, "Wrong control type: " .. flag end
            local value, valid = entry.Value, false
            if control.Type == "Toggle" then valid = type(value) == "boolean"
            elseif control.Type == "Slider" then valid = finite(value)
            elseif control.Type == "Input" then valid = type(value) == "string"
            elseif control.Type == "Keybind" then valid = keycode(value) ~= nil
            elseif control.Type == "Colorpicker" then
                valid = type(value) == "string" and value:match("^%x%x%x%x%x%x$") ~= nil and finite(entry.Alpha) and type(entry.Rainbow) == "boolean"
            elseif control.Type == "Dropdown" then
                if control.Multi then
                    valid = type(value) == "table"
                    if valid then
                        local count = 0
                        for index, item in pairs(value) do
                            count += 1
                            if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > #value or not table.find(control.Values, item) then valid = false break end
                        end
                        valid = valid and count == #value
                    end
                else valid = value == nil or table.find(control.Values, value) ~= nil end
            end
            if not valid then return false, "Invalid value: " .. flag end
            changes[control] = entry
        end
    end
    -- Stable creation order makes callbacks predictable, including theme controls.
    for _, control in ipairs(self.Controls) do
        local entry = changes[control]
        if entry then
            if control.Type == "Colorpicker" then
                control:Set(Color3.fromHex(entry.Value), entry.Alpha, true)
                control:SetRainbow(entry.Rainbow, true)
            else control:Set(entry.Value, true) end
        end
    end
    if not silent then
        for _, control in ipairs(self.Controls) do
            if changes[control] then
                if control.Type == "Colorpicker" then call(control.Callback, control.Value, control.Alpha)
                elseif control.Type ~= "Keybind" then call(control.Callback, copy(control.Value)) end
            end
        end
    end
    return true
end

local function configPath(name)
    if type(name) ~= "string" or #name < 1 or #name > 48 or not name:match("^[%w_%-]+$") then return nil end
    return "SableUI_" .. name .. ".json"
end

function Window:SaveConfig(name)
    local path = configPath(name)
    if not path then return false, "Use 1–48 letters, numbers, dashes or underscores" end
    local write = getfenv(0).writefile
    if type(write) ~= "function" then return false, "File saving is unavailable. Use ExportConfig() instead." end
    local ok, message = pcall(function() write(path, self:ExportConfig()) end)
    return ok, ok and path or tostring(message)
end

function Window:LoadConfig(name, silent)
    local path = configPath(name)
    if not path then return false, "Invalid config name" end
    local read = getfenv(0).readfile
    if type(read) ~= "function" then return false, "File loading is unavailable. Use ImportConfig(json) instead." end
    local ok, json = pcall(read, path)
    if not ok then return false, "Could not read " .. path end
    return self:ImportConfig(json, silent)
end

function Window:DeleteConfig(name)
    local path = configPath(name)
    if not path then return false, "Invalid config name" end
    local delete = getfenv(0).delfile
    if type(delete) ~= "function" then return false, "File deletion is unavailable in this environment" end
    local ok, message = pcall(delete, path)
    return ok, ok and "Deleted " .. path or tostring(message)
end

return Library
