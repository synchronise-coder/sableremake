    local box = make("Frame", { BorderSizePixel = 0, Position = UDim2.fromOffset(0, 2), Size = UDim2.fromOffset(13, 13) }, hit)
    corner(box, 2)
    local outline = stroke(box, window.Theme.Border, 0.3)
    local check = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, box)
    line(check, Vector2.new(3, 7), Vector2.new(5, 9), window.Theme.Background, 1.5)
    line(check, Vector2.new(5, 9), Vector2.new(10, 4), window.Theme.Background, 1.5)
    local title = label(hit, options.Name or "Toggle", 14, window.Theme.Text, { Position = UDim2.fromOffset(21, 0), Size = UDim2.new(1, -21, 1, 0) })
    function control:_paint()
        box.BackgroundColor3 = self.Value and window.Theme.Accent or window.Theme.Control
        outline.Color = self.Value and window.Theme.Accent or window.Theme.Border
        check.Visible = self.Value == true
        box.BackgroundTransparency = self.Disabled and 0.5 or 0
        title.TextTransparency = self.Disabled and 0.55 or 0
    end
    function control:Set(value, silent)
