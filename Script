function Section:Colorpicker(options)
    options = options or {}
    local window = self.Window
    local row = self:_row(21)
    local control = self:_control(options, "Colorpicker", row)
    control.Alpha = math.clamp(options.Alpha or 1, 0, 1)
    control.Rainbow = false
    label(row, options.Name or "Color", 14, window.Theme.Text, { Size = UDim2.new(1, -48, 1, 0) })
    local swatch = button(row, "", { BackgroundTransparency = 0, Position = UDim2.new(1, -33, 0, 3), Size = UDim2.fromOffset(33, 15) })
    corner(swatch, 2)
    stroke(swatch, window.Theme.Border)
    local popup = window:_popupFrame(242, 246)
    local saturation = button(popup, "", { BackgroundTransparency = 0, Position = UDim2.fromOffset(9, 9), Size = UDim2.fromOffset(203, 143) })
    make("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1, 1, 1)), Transparency = NumberSequence.new(0, 1) }, make("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1) }, saturation))
    make("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, make("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 1) }, saturation))
    local cursor = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(7, 7), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3 }, saturation)
    corner(cursor, 4)
    stroke(cursor, Color3.new(1, 1, 1))
    local hue = button(popup, "", { BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), Position = UDim2.fromOffset(220, 9), Size = UDim2.fromOffset(12, 143) })
    local points = {}
    for index = 0, 6 do points[#points + 1] = ColorSequenceKeypoint.new(index / 6, Color3.fromHSV(index / 6, 1, 1)) end
    make("UIGradient", { Rotation = 90, Color = ColorSequence.new(points) }, hue)
    local hueCursor = make("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, 4, 0, 2), Position = UDim2.fromOffset(-2, 0) }, hue)
    local alpha = button(popup, "", { BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), Position = UDim2.fromOffset(9, 161), Size = UDim2.fromOffset(223, 13) })
    local alphaGradient = make("UIGradient", {}, alpha)
    local alphaCursor = make("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromOffset(2, 17), Position = UDim2.new(1, -1, 0, -2) }, alpha)
    local rgb = field(popup, "", { Position = UDim2.fromOffset(9, 183), Size = UDim2.fromOffset(130, 23), TextSize = 12 })
    local hex = field(popup, "", { Position = UDim2.fromOffset(145, 183), Size = UDim2.fromOffset(87, 23), TextSize = 12 })
    local rainbow = button(popup, "□  Rainbow", { Position = UDim2.fromOffset(9, 214), Size = UDim2.fromOffset(113, 24), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = window.Theme.Muted })
    local alphaLabel = label(popup, "Alpha: 1.00", 12, window.Theme.Muted, { Position = UDim2.fromOffset(130, 214), Size = UDim2.fromOffset(102, 24), TextXAlignment = Enum.TextXAlignment.Right })
    function control:_paint()
        local color = self.Value
        swatch.BackgroundColor3 = color
        swatch.BackgroundTransparency = 1 - self.Alpha
        saturation.BackgroundColor3 = Color3.fromHSV(self.H, 1, 1)
        cursor.Position = UDim2.fromScale(self.S, 1 - self.V)
        hueCursor.Position = UDim2.new(0, -2, self.H, -1)
        alphaGradient.Color = ColorSequence.new(window.Theme.Control, color)
        alphaCursor.Position = UDim2.new(self.Alpha, -1, 0, -2)
        rgb.Text = string.format("%d, %d, %d", math.round(color.R * 255), math.round(color.G * 255), math.round(color.B * 255))
        hex.Text = "#" .. color:ToHex():upper()
        alphaLabel.Text = string.format("Alpha: %.2f", self.Alpha)
        rainbow.Text = (self.Rainbow and "✓" or "□") .. "  Rainbow"
        rainbow.TextColor3 = self.Rainbow and window.Theme.Accent or window.Theme.Muted
    end
    function control:_publish(silent)
        if self.Flag then window.Flags[self.Flag] = { Color = self.Value, Alpha = self.Alpha, Rainbow = self.Rainbow } end
        if not silent then call(self.Callback, self.Value, self.Alpha) end
    end
    function control:Set(color, alphaValue, silent)
        assert(typeof(color) == "Color3", "Colorpicker:Set expects a Color3")
        self.Value = color
        if alphaValue ~= nil then assert(finite(alphaValue), "Alpha must be a number") self.Alpha = math.clamp(alphaValue, 0, 1) end
        self.H, self.S, self.V = color:ToHSV()
        self:_paint()
        self:_publish(silent)
    end
    function control:SetRainbow(enabled, silent)
        self.Rainbow = enabled == true
        window._rainbows[self] = self.Rainbow and true or nil
        self:_paint()
        self:_publish(silent)
    end
    function control:_rainbowStep()
        if not self.Disabled then self:Set(Color3.fromHSV((os.clock() / 8) % 1, 0.8, 1), self.Alpha) end
    end
    local function change(h, s, v)
        control.Rainbow = false
        window._rainbows[control] = nil
        control.H, control.S, control.V = h, s, v
        control.Value = Color3.fromHSV(h, s, v)
        control:_paint()
        control:_publish()
    end
    window:_track(saturation, function(point)
        if control.Disabled then return end
        local relative = point - saturation.AbsolutePosition
        change(control.H, math.clamp(relative.X / math.max(1, saturation.AbsoluteSize.X), 0, 1), 1 - math.clamp(relative.Y / math.max(1, saturation.AbsoluteSize.Y), 0, 1))
    end)
    window:_track(hue, function(point)
        if not control.Disabled then change(math.clamp((point.Y - hue.AbsolutePosition.Y) / math.max(1, hue.AbsoluteSize.Y), 0, 1), control.S, control.V) end
    end)
    window:_track(alpha, function(point)
        if not control.Disabled then control:Set(control.Value, math.clamp((point.X - alpha.AbsolutePosition.X) / math.max(1, alpha.AbsoluteSize.X), 0, 1)) end
    end)
    window:_connect(rainbow.Activated, function() if not control.Disabled then control:SetRainbow(not control.Rainbow) end end)
    window:_connect(swatch.Activated, function() if not control.Disabled then window:_openPopup(popup, swatch) end end)
    window:_connect(hex.FocusLost, function()
        local text = hex.Text:gsub("#", ""):gsub("%s", "")
        if not control.Disabled and text:match("^%x%x%x%x%x%x$") then
            control:SetRainbow(false, true)
            control:Set(Color3.fromHex(text), control.Alpha)
        else control:_paint() end
    end)
    window:_connect(rgb.FocusLost, function()
        local r, g, b = rgb.Text:match("^%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*$")
        if not control.Disabled and r and tonumber(r) <= 255 and tonumber(g) <= 255 and tonumber(b) <= 255 then
            control:SetRainbow(false, true)
            control:Set(Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)), control.Alpha)
        else control:_paint() end
    end)
    control:Set(options.Default or window.Theme.Accent, control.Alpha, true)
    if options.Rainbow then control:SetRainbow(true, true) end
    return control
end

function Window:Notify(options)
    if self._dead then return end
    options = type(options) == "string" and { Content = options } or options or {}
    if #self._notices >= 4 then
        local old = table.remove(self._notices, 1)
        self._tweens[old.Frame] = nil
        old.Frame:Destroy()
    end
    local frame = make("CanvasGroup", {
        BackgroundColor3 = self.Theme.Header, BorderSizePixel = 0,
        Size = UDim2.fromOffset(235, 64), GroupTransparency = 1,
    }, self.Notifications)
    corner(frame, 4)
    stroke(frame, self.Theme.Border)
    label(frame, options.Title or "Sable", 14, self.Theme.Text, { Position = UDim2.fromOffset(11, 8), Size = UDim2.new(1, -22, 0, 18) })
    label(frame, options.Content or "", 13, self.Theme.Muted, { Position = UDim2.fromOffset(11, 29), Size = UDim2.new(1, -22, 0, 28), TextWrapped = true, TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top })
    self:_tween(frame, { GroupTransparency = 0 }, 0.18)
    self._notices[#self._notices + 1] = { Frame = frame, Time = math.clamp(options.Duration or 4, 0.5, 60) }
end

function Window:CreateWatermark(options)
    options = options or {}
    if self.Watermark then return self.Watermark end
    local frame, body, header, title = self:_surface("Watermark", "", UDim2.fromOffset(8, 15), UDim2.fromOffset(470, 28))
    header.Size = UDim2.fromScale(1, 1)
    local widget = { Frame = frame, Name = options.Name or "Sable", Context = options.Context or "Roblox", Game = options.Game or "Interface preview", ShowFPS = options.ShowFPS ~= false, Ping = options.Ping }
    local window = self
    function widget:_update()
        local items = { self.Name, self.Context, self.Game }
        if self.ShowFPS then items[#items + 1] = "FPS: " .. tostring(window.FPS or "—") end
        if self.Ping ~= nil then items[#items + 1] = "Ping: " .. tostring(self.Ping) .. "ms" end
        title.Text = table.concat(items, "  |  ")
    end
    function widget:SetContext(text) self.Context = tostring(text) self:_update() end
    function widget:SetPing(milliseconds) self.Ping = milliseconds self:_update() end
    function widget:SetVisible(visible) frame.Visible = visible == true end
    body.ClipsDescendants = true
    widget:_update()
    self.Watermark = widget
    return widget
end

function Window:_refreshKeybinds()
    if not self.KeybindPanel then return end
    local widget = self.KeybindPanel
    local visible = 0
    for index, binding in ipairs(self._bindings) do
        local item = widget.Rows[index]
        if not item then
            item = button(widget.List, "", { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = index })
            label(item, binding.Name, 13, self.Theme.Text, { Name = "BindingName", Size = UDim2.new(1, -62, 1, 0) })
            label(item, "", 12, self.Theme.Muted, { Name = "BindingKey", Position = UDim2.new(1, -60, 0, 0), Size = UDim2.fromOffset(60, 22), TextXAlignment = Enum.TextXAlignment.Right })
            item.Activated:Connect(function() binding:_capture() end)
            widget.Rows[index] = item
        end
        local active = binding.Active
        if binding.Target then active = binding.Target.Value end
        item.BindingName.TextColor3 = active and self.Theme.Accent or self.Theme.Text
        item.BindingKey.Text = keyname(binding.Value)
        item.Visible = not widget.ActiveOnly or active == true
        if item.Visible then visible += 1 end
    end
    widget.Empty.Visible = visible == 0
    widget.Frame.Size = UDim2.fromOffset(205, 39 + math.min(math.max(1, visible), 8) * 22)
end

