    local hueCursor = make("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, 4, 0, 2), Position = UDim2.fromOffset(-2, 0) }, hue)
    local alpha = button(popup, "", { BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1), Position = UDim2.fromOffset(8, 146), Size = UDim2.fromOffset(202, 12) })
    local alphaGradient = make("UIGradient", {}, alpha)
    local alphaCursor = make("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromOffset(2, 17), Position = UDim2.new(1, -1, 0, -2) }, alpha)
    local rgb = field(popup, "", { Position = UDim2.fromOffset(8, 167), Size = UDim2.fromOffset(103, 19), TextSize = 12 })
    local hex = field(popup, "", { Position = UDim2.fromOffset(116, 167), Size = UDim2.fromOffset(94, 19), TextSize = 12 })
    local function smallToggle(text, x)
        local hit = button(popup, "", { Position = UDim2.fromOffset(x, 189), Size = UDim2.fromOffset(95, 17) })
        local check = make("Frame", { BackgroundColor3 = window.Theme.Control, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 3), Size = UDim2.fromOffset(11, 11) }, hit)
        corner(check, 2)
        stroke(check, window.Theme.Border, 0.25)
        local mark = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, check)
        line(mark, Vector2.new(2, 6), Vector2.new(4, 8), window.Theme.Accent)
        line(mark, Vector2.new(4, 8), Vector2.new(9, 3), window.Theme.Accent)
        label(hit, text, 13, window.Theme.Muted, { Position = UDim2.fromOffset(17, 0), Size = UDim2.new(1, -17, 1, 0) })
        return hit, mark
    end
    local rainbow, rainbowMark = smallToggle("Rainbow", 8)
    local alphaToggle, alphaMark = smallToggle("Alpha", 116)
    function control:_paint()
        local color = self.Value
        swatch.BackgroundColor3 = color
        swatch.BackgroundTransparency = 1 - self.Alpha
        saturation.BackgroundColor3 = Color3.fromHSV(self.H, 1, 1)
        cursor.Position = UDim2.fromScale(self.S, 1 - self.V)
        hueCursor.Position = UDim2.new(0, -2, self.H, -1)
        alphaGradient.Color = ColorSequence.new(window.Theme.Control, color)
        alphaCursor.Position = UDim2.new(self.Alpha, -1, 0, -2)
        rgb.Text = string.format("%d, %d, %d, %.2f", math.round(color.R * 255), math.round(color.G * 255), math.round(color.B * 255), self.Alpha)
        hex.Text = "#" .. color:ToHex():upper() .. string.format("%02X", math.round(self.Alpha * 255))
        rainbowMark.Visible = self.Rainbow
        alphaMark.Visible = self.AlphaEnabled
        alphaCursor.Visible = self.AlphaEnabled
    end
    function control:_publish(silent)
        if self.Flag then window.Flags[self.Flag] = { Color = self.Value, Alpha = self.Alpha, Rainbow = self.Rainbow, AlphaEnabled = self.AlphaEnabled } end
        if not silent then call(self.Callback, self.Value, self.Alpha) end
    end
    function control:Set(color, alphaValue, silent)
        assert(typeof(color) == "Color3", "Colorpicker:Set expects a Color3")
        self.Value = color
        if alphaValue ~= nil then assert(finite(alphaValue), "Alpha must be a number") self.Alpha = math.clamp(alphaValue, 0, 1) end
        if not self.AlphaEnabled then self.Alpha = 1 end
        self.H, self.S, self.V = color:ToHSV()
        self:_paint()
        self:_publish(silent)
    end
    function control:SetRainbow(enabled, silent)
        self.Rainbow = enabled == true
        window._rainbows[self] = self.Rainbow and true or nil
        self:_paint()
        self:_publish(silent)
    end
    function control:SetAlphaEnabled(enabled, silent)
        enabled = enabled == true
        if enabled == self.AlphaEnabled then return end
        if not enabled then self._savedAlpha = self.Alpha end
        self.AlphaEnabled = enabled
        self:Set(self.Value, enabled and (self._savedAlpha or self.Alpha) or 1, silent)
    end
    function control:Open(position)
        if self.Disabled then return end
        window:_openPopup(popup, swatch)
        if position then popup.Position = position end
    end
    function control:_rainbowStep()
        if not self.Disabled then self:Set(Color3.fromHSV((os.clock() / 8) % 1, 0.8, 1), self.Alpha) end
    end
    local function change(h, s, v)
        control.Rainbow = false
        window._rainbows[control] = nil
        control.H, control.S, control.V = h, s, v
        control.Value = Color3.fromHSV(h, s, v)
        control:_paint()
        control:_publish()
    end
    window:_track(saturation, function(point)
        if control.Disabled then return end
        local relative = point - saturation.AbsolutePosition
        change(control.H, math.clamp(relative.X / math.max(1, saturation.AbsoluteSize.X), 0, 1), 1 - math.clamp(relative.Y / math.max(1, saturation.AbsoluteSize.Y), 0, 1))
    end)
    window:_track(hue, function(point)
        if not control.Disabled then change(math.clamp((point.Y - hue.AbsolutePosition.Y) / math.max(1, hue.AbsoluteSize.Y), 0, 1), control.S, control.V) end
    end)
    window:_track(alpha, function(point)
        if not control.Disabled and control.AlphaEnabled then control:Set(control.Value, math.clamp((point.X - alpha.AbsolutePosition.X) / math.max(1, alpha.AbsoluteSize.X), 0, 1)) end
    end)
    window:_connect(rainbow.Activated, function() if not control.Disabled then control:SetRainbow(not control.Rainbow) end end)
    window:_connect(alphaToggle.Activated, function() if not control.Disabled then control:SetAlphaEnabled(not control.AlphaEnabled) end end)
    window:_connect(swatch.Activated, function() if not control.Disabled then window:_openPopup(popup, swatch) end end)
    window:_connect(hex.FocusLost, function()
        local text = hex.Text:gsub("#", ""):gsub("%s", "")
        if not control.Disabled and (#text == 6 or #text == 8) and text:match("^%x+$") then
            control:SetRainbow(false, true)
            control:Set(Color3.fromHex(text:sub(1, 6)), #text == 8 and tonumber(text:sub(7, 8), 16) / 255 or control.Alpha)
        else control:_paint() end
    end)
    window:_connect(rgb.FocusLost, function()
        local values = string.split(rgb.Text, ",")
        local r, g, b, a = tonumber(values[1]), tonumber(values[2]), tonumber(values[3]), tonumber(values[4])
        local valid = (#values == 3 or #values == 4) and finite(r) and finite(g) and finite(b)
            and r >= 0 and r <= 255 and g >= 0 and g <= 255 and b >= 0 and b <= 255
            and (#values == 3 or (finite(a) and a >= 0 and a <= 1))
        if not control.Disabled and valid then
            control:SetRainbow(false, true)
            control:Set(Color3.fromRGB(r, g, b), a or control.Alpha)
        else control:_paint() end
    end)
    control:Set(options.Default or window.Theme.Accent, control.Alpha, true)
    if options.Rainbow then control:SetRainbow(true, true) end
    return control
end

function Window:Notify(options)
    if self._dead then return end
    options = type(options) == "string" and { Content = options } or options or {}
    if #self._notices >= 4 then
        local old = table.remove(self._notices, 1)
        self._tweens[old.Frame] = nil
        old.Frame:Destroy()
    end
    local frame = make("CanvasGroup", {
        BackgroundColor3 = self.Theme.Header, BorderSizePixel = 0,
        Size = UDim2.fromOffset(165, 50), GroupTransparency = 1,
    }, self.Notifications)
    corner(frame, 4)
    stroke(frame, self.Theme.Border)
    label(frame, options.Title or "Sable", 14, self.Theme.Text, { Position = UDim2.fromOffset(8, 6), Size = UDim2.new(1, -16, 0, 16) })
    label(frame, options.Content or "", 13, self.Theme.Muted, { Position = UDim2.fromOffset(8, 26), Size = UDim2.new(1, -16, 0, 21), TextWrapped = true, TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top })
    self:_tween(frame, { GroupTransparency = 0 }, 0.18)
    self._notices[#self._notices + 1] = { Frame = frame, Time = math.clamp(options.Duration or 4, 0.5, 60) }
end

