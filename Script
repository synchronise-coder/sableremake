        control.Keybind = window:_binding(row, { Name = options.Name, Default = options.Keybind, Mode = "Toggle", Flag = options.KeybindFlag }, control)
    end
    return control
end

function Section:Slider(options)
    options = options or {}
    local window = self.Window
    local minimum, maximum, step = options.Min or 0, options.Max or 100, options.Step or 1
    assert(finite(minimum) and finite(maximum) and maximum > minimum, "Slider Max must exceed Min")
    assert(finite(step) and step > 0, "Slider Step must be positive")
    local row = self:_row(28)
    local control = self:_control(options, "Slider", row)
    control.Min, control.Max, control.Step = minimum, maximum, step
    local title = label(row, options.Name or "Slider", 14, window.Theme.Text, { Size = UDim2.new(0.6, 0, 0, 19) })
    local valueBox = field(row, "", { BackgroundTransparency = 1, Position = UDim2.new(0.6, 0, 0, 0), Size = UDim2.new(0.4, 0, 0, 19), TextXAlignment = Enum.TextXAlignment.Right })
    local hit = button(row, "", { Position = UDim2.fromOffset(0, 17), Size = UDim2.new(1, 0, 0, 13) })
    local track = make("Frame", { BackgroundColor3 = window.Theme.Control, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 5), Size = UDim2.new(1, 0, 0, 4) }, hit)
    corner(track, 3)
    local fill = make("Frame", { BackgroundColor3 = window.Theme.Accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, track)
    corner(fill, 3)
    window:_accent(fill, "BackgroundColor3")
    local knob = make("Frame", { BackgroundColor3 = window.Theme.Text, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), Position = UDim2.fromScale(0, 0.5) }, track)
    corner(knob, 5)
    local decimals = 0
    while decimals < 6 and math.abs(step * 10 ^ decimals - math.round(step * 10 ^ decimals)) > 0.000001 do decimals += 1 end
    function control:_paint()
        local fraction = (self.Value - minimum) / (maximum - minimum)
        fill.Size = UDim2.fromScale(fraction, 1)
        knob.Position = UDim2.fromScale(fraction, 0.5)
        valueBox.Text = options.Format and tostring(options.Format(self.Value)) or (string.format("%." .. decimals .. "f", self.Value) .. (options.Suffix or ""))
        title.TextTransparency = self.Disabled and 0.55 or 0
        valueBox.TextEditable = not self.Disabled
    end
    function control:Set(value, silent)
        assert(finite(value), "Slider:Set expects a finite number")
        self.Value = math.clamp(minimum + math.round((value - minimum) / step) * step, minimum, maximum)
        self:_paint()
        self:_publish(silent)
    end
    window:_track(hit, function(point)
        if control.Disabled then return end
        local fraction = math.clamp((point.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        control:Set(minimum + (maximum - minimum) * fraction)
    end)
    window:_connect(valueBox.Focused, function() if not control.Disabled then valueBox.Text = tostring(control.Value) end end)
    window:_connect(valueBox.FocusLost, function()
        local value = tonumber(valueBox.Text)
        if not control.Disabled and finite(value) then control:Set(value) else control:_paint() end
    end)
    control:Set(options.Default or minimum, true)
    return control
end

function Section:Input(options)
    options = options or {}
