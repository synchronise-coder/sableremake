    local widget = { Frame = frame, List = list, Messages = {}, Limit = math.clamp(options.MaxMessages or 60, 1, 200), _count = 0, _pinBottom = true }
    function widget:SetVisible(visible) frame.Visible = visible == true end
    function widget:SetStatus(text, connected)
        status.Text = tostring(text)
        local color = connected and window.Theme.Success or window.Theme.Muted
        dot.BackgroundColor3, glow.BackgroundColor3 = color, color
    end
    function widget:AddMessage(message)
        if window._dead then return end
        message = message or {}
        self._pinBottom = list.AbsoluteCanvasSize.Y - list.CanvasPosition.Y - list.AbsoluteSize.Y < 28
        self._count += 1
        local row = make("Frame", { Name = "Message", BackgroundTransparency = 1, Size = UDim2.new(1, -3, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self._count }, list)
        local userId = tonumber(message.UserId) or Players.LocalPlayer.UserId
        local avatar = make("ImageLabel", {
            Name = "Avatar", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 1), Size = UDim2.fromOffset(23, 23),
            Image = message.Avatar or ("rbxthumb://type=AvatarHeadShot&id=" .. tostring(userId) .. "&w=48&h=48"),
        }, row)
        corner(avatar, 12)
        local content = make("Frame", { Name = "Content", BackgroundTransparency = 1, Position = UDim2.fromOffset(29, 0), Size = UDim2.new(1, -29, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, row)
        stack(content, 4)
        label(content, tostring(message.Author or "Other"):sub(1, 60), 13, window.Theme.Text, { Size = UDim2.new(1, 0, 0, 13), LayoutOrder = 1 })
        local bubble = make("Frame", { Name = "Bubble", BackgroundColor3 = window.Theme.Control, BorderSizePixel = 0, Size = UDim2.fromOffset(0, 0), AutomaticSize = Enum.AutomaticSize.XY, LayoutOrder = 2 }, content)
        corner(bubble, 2)
        pad(bubble, 5)
        make("UISizeConstraint", { MaxSize = Vector2.new(183, 10000), MinSize = Vector2.new(22, 20) }, bubble)
        local messageLabel = label(bubble, tostring(message.Text or ""):sub(1, 512), 13, window.Theme.Muted, {
            Size = UDim2.fromOffset(0, 12), AutomaticSize = Enum.AutomaticSize.XY,
            TextWrapped = true, TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top,
        })
        make("UISizeConstraint", { MaxSize = Vector2.new(173, 10000) }, messageLabel)
        self.Messages[#self.Messages + 1] = row
        if #self.Messages > self.Limit then table.remove(self.Messages, 1):Destroy() end
        if self._count >= 10000 then
            for index, item in ipairs(self.Messages) do item.LayoutOrder = index end
            self._count = #self.Messages
        end
    end
    function widget:Clear()
        for _, row in ipairs(self.Messages) do row:Destroy() end
        table.clear(self.Messages)
        self._count = 0
    end
    local function submit()
        local text = input.Text:match("^%s*(.-)%s*$")
        if text == "" then return end
        input.Text = ""
        if options.OnSend then call(options.OnSend, text:sub(1, 512), widget)
        else widget:AddMessage({ Author = Players.LocalPlayer.DisplayName, UserId = Players.LocalPlayer.UserId, Text = text }) end
    end
    self:_connect(input.FocusLost, function(enter) if enter then submit() end end)
    self:_connect(input:GetPropertyChangedSignal("Text"), function() send.Visible = input.Text ~= "" end)
    self:_connect(send.Activated, submit)
    self:_connect(close.Activated, function() widget:SetVisible(false) end)
    self:_connect(list.InputBegan, function(event) if isPointer(event) then widget._pinBottom = false end end)
    self:_connect(list.InputChanged, function(event) if event.UserInputType == Enum.UserInputType.MouseWheel then widget._pinBottom = false end end)
    self:_connect(list:GetPropertyChangedSignal("AbsoluteCanvasSize"), function()
        if widget._pinBottom then list.CanvasPosition = Vector2.new(0, math.max(0, list.AbsoluteCanvasSize.Y - list.AbsoluteSize.Y)) end
    end)
    self.Chat = widget
    return widget
end

