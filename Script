function Section:Dropdown(options)
    options = options or {}
    local window = self.Window
    local row = self:_row(48)
    local control = self:_control(options, "Dropdown", row)
    control.Values, control.Multi = {}, options.Multi == true
    label(row, options.Name or "Dropdown", 14, window.Theme.Text)
    local hit = button(row, "", { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 0, BackgroundColor3 = window.Theme.Control })
    corner(hit, 2)
    local selected = label(hit, "", 13, window.Theme.Muted, { Position = UDim2.fromOffset(7, 0), Size = UDim2.new(1, -28, 1, 0) })
    label(hit, "⌄", 14, window.Theme.Muted, { Position = UDim2.new(1, -20, 0, 0), Size = UDim2.fromOffset(16, 25), TextXAlignment = Enum.TextXAlignment.Center })
    local popup = window:_popupFrame(218, 160)
    local list = make("ScrollingFrame", {
        BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(4, 4),
        Size = UDim2.new(1, -8, 1, -8), ScrollBarThickness = 2, ScrollBarImageColor3 = window.Theme.Accent,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, popup)
    stack(list, 2)
    local rows = {}
    function control:_paint()
        selected.Text = self.Multi and (#self.Value > 0 and table.concat(self.Value, ", ") or "None") or (self.Value or "None")
        selected.TextTransparency = self.Disabled and 0.55 or 0
        for value, item in pairs(rows) do
            local active = self.Multi and table.find(self.Value, value) ~= nil or self.Value == value
            item.TextColor3 = active and window.Theme.Accent or window.Theme.Text
            item.BackgroundTransparency = active and 0 or 1
        end
    end
    function control:Set(value, silent)
        if self.Multi then
            assert(type(value) == "table", "Multi-dropdown:Set expects an array")
            local chosen = {}
            for _, item in ipairs(value) do
                if table.find(self.Values, item) and not table.find(chosen, item) then chosen[#chosen + 1] = item end
            end
            self.Value = chosen
        else
            assert(value == nil or table.find(self.Values, value), "Dropdown value is not in Values")
            self.Value = value
        end
        self:_paint()
        self:_publish(silent)
    end
    function control:SetValues(values, silent)
        assert(type(values) == "table", "Values must be an array")
        window:_closePopup()
        for _, item in pairs(rows) do item:Destroy() end
        table.clear(rows)
        table.clear(self.Values)
        for _, value in ipairs(values) do
            assert(type(value) == "string", "Dropdown values must be strings")
            if not table.find(self.Values, value) then
                self.Values[#self.Values + 1] = value
                local item = button(list, value, {
                    Size = UDim2.new(1, -3, 0, 25), TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundColor3 = window.Theme.Section, LayoutOrder = #self.Values,
                })
                make("UIPadding", { PaddingLeft = UDim.new(0, 7) }, item)
                corner(item, 2)
                -- Destroying each item disconnects its local event; no growing registry.
                item.Activated:Connect(function()
                    if self.Disabled then return end
                    if self.Multi then
                        local nextValue = table.clone(self.Value)
                        local index = table.find(nextValue, value)
                        if index then table.remove(nextValue, index) else nextValue[#nextValue + 1] = value end
                        self:Set(nextValue)
                    else
                        self:Set(value)
                        window:_closePopup()
                    end
                end)
                rows[value] = item
            end
        end
        popup.Size = UDim2.fromOffset(218, math.clamp(#self.Values * 27 + 8, 36, 200))
        local nextValue = self.Multi and (self.Value or {}) or self.Value
        if not self.Multi and not table.find(self.Values, nextValue) then nextValue = self.Values[1] end
        self:Set(nextValue, silent)
    end
    window:_connect(hit.Activated, function()
        if not control.Disabled then window:_openPopup(popup, hit) end
    end)
    control:SetValues(options.Values or {}, true)
    if options.Default ~= nil then control:Set(options.Default, true) end
    return control
end

function Window:_binding(row, options, target)
    local window = self
    local binding = {
        Type = "Keybind", Window = self, Frame = row, Flag = options.Flag, Name = options.Name or "Keybind",
        Mode = options.Mode or "Toggle", Callback = options.Callback, Target = target,
        Active = false, Disabled = options.Disabled == true,
    }
    assert(binding.Mode == "Hold" or binding.Mode == "Toggle" or binding.Mode == "Press", "Keybind Mode must be Hold, Toggle or Press")
    local hit = button(row, "", { Position = UDim2.new(1, -55, 0, 0), Size = UDim2.fromOffset(55, 20), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right })
    function binding:Get() return self.Value end
    function binding:_paint()
        hit.Text = window._capturing == self and "[ ... ]" or ("[ " .. keyname(self.Value) .. " ]")
        hit.TextColor3 = window._capturing == self and window.Theme.Accent or window.Theme.Muted
    end
    function binding:Set(value, silent)
        local key = keycode(value)
        assert(key, "Keybind:Set expects an Enum.KeyCode or its name")
        if self.Mode == "Hold" and self.Active then call(self.Callback, false, self.Value) end
        self.Active = false
        self.Value = key
        if self.Flag then window.Flags[self.Flag] = key.Name end
        self:_paint()
        window:_refreshKeybinds()
        if not silent then call(options.Changed, key) end
    end
    function binding:SetDisabled(value) self.Disabled = value == true end
    function binding:SetVisible(value) row.Visible = value == true end
    function binding:_capture()
        if self.Disabled then return end
        local previous = window._capturing
        window._capturing = self
        if previous then previous:_paint() end
        window:_closePopup()
        self:_paint()
    end
    self:_connect(hit.Activated, function() binding:_capture() end)
    if binding.Flag then
        assert(type(binding.Flag) == "string" and not self._byFlag[binding.Flag], "Flags must be unique strings")
        self._byFlag[binding.Flag] = binding
    end
    self._bindings[#self._bindings + 1] = binding
    self.Controls[#self.Controls + 1] = binding
    binding:Set(options.Default or Enum.KeyCode.Unknown, true)
    return binding
end

function Section:Keybind(options)
