-- SableUI v1.0.1 | client-side Roblox Luau
-- A standalone recreation of the supplied Sable interface.
-- Upload this file to a raw URL, then load it with:
-- local SableUI = loadstring(game:HttpGet("YOUR_RAW_LIBRARY_URL"))()
-- See SableUI_Example.lua for every control and the floating panels.
-- No external packages, HTTP calls or required image assets. MascotImage is optional.

local Players = game:GetService("Players")
local Input = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local Library = { Version = "1.0.1" }
local Window = {}
local Tab = {}
local Section = {}
Window.__index = Window
Tab.__index = Tab
Section.__index = Section

local Theme = {
    Background = Color3.fromRGB(18, 17, 22),
    Header = Color3.fromRGB(29, 27, 34),
    Section = Color3.fromRGB(26, 24, 31),
    Control = Color3.fromRGB(20, 18, 25),
    Border = Color3.fromRGB(45, 42, 52),
    Text = Color3.fromRGB(225, 223, 233),
    Muted = Color3.fromRGB(140, 136, 151),
    Accent = Color3.fromRGB(142, 186, 226),
    Success = Color3.fromRGB(104, 205, 139),
}

local function make(class, properties, parent)
    local object = Instance.new(class)
    for property, value in pairs(properties or {}) do
        object[property] = value
    end
    object.Parent = parent
    return object
end

local function corner(object, radius)
    return make("UICorner", { CornerRadius = UDim.new(0, radius or 3) }, object)
end

local function stroke(object, color, transparency)
    return make("UIStroke", {
        Color = color, Thickness = 1, Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, object)
end

local function pad(object, amount)
    return make("UIPadding", {
        PaddingLeft = UDim.new(0, amount), PaddingRight = UDim.new(0, amount),
        PaddingTop = UDim.new(0, amount), PaddingBottom = UDim.new(0, amount),
    }, object)
end

local function stack(object, gap)
    return make("UIListLayout", {
        Padding = UDim.new(0, gap or 0), SortOrder = Enum.SortOrder.LayoutOrder,
    }, object)
end

local function label(parent, text, size, color, props)
    local object = make("TextLabel", {
        BackgroundTransparency = 1, BorderSizePixel = 0, Font = Enum.Font.SourceSansSemibold,
        Text = tostring(text or ""), TextSize = size or 14,
        TextColor3 = color or Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, 0, 0, 20), TextTruncate = Enum.TextTruncate.AtEnd,
    }, parent)
    for property, value in pairs(props or {}) do object[property] = value end
    return object
end

local function button(parent, text, props)
    local object = make("TextButton", {
        BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false,
        Font = Enum.Font.SourceSansSemibold, Text = text or "", TextSize = 14,
        TextColor3 = Theme.Text, Size = UDim2.fromScale(1, 1),
    }, parent)
    for property, value in pairs(props or {}) do object[property] = value end
    return object
end

local function field(parent, text, props)
    local object = make("TextBox", {
        BackgroundColor3 = Theme.Control, BorderSizePixel = 0,
        Font = Enum.Font.SourceSans, TextSize = 13, TextColor3 = Theme.Text,
        PlaceholderColor3 = Theme.Muted, TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false, Text = tostring(text or ""),
        Size = UDim2.new(1, 0, 0, 25),
    }, parent)
    corner(object, 2)
    make("UIPadding", { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7) }, object)
    for property, value in pairs(props or {}) do object[property] = value end
    return object
end

local function pointer(input)
    return Vector2.new(input.Position.X, input.Position.Y)
end

local function isPointer(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function inside(object, point)
    if not object or not object.Parent or not object.Visible then return false end
    local p, s = object.AbsolutePosition, object.AbsoluteSize
    return point.X >= p.X and point.X <= p.X + s.X and point.Y >= p.Y and point.Y <= p.Y + s.Y
end

local function finite(value)
    return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function copy(value)
    return type(value) == "table" and table.clone(value) or value
end

local function keycode(value)
    if typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode then return value end
    if type(value) == "string" then
        local ok, key = pcall(function() return Enum.KeyCode[value] end)
        if ok then return key end
    end
    return nil
end

local function keyname(value)
    if not value or value == Enum.KeyCode.Unknown then return "_" end
    local names = { LeftControl = "LCtrl", RightControl = "RCtrl", LeftShift = "LShift", RightShift = "RShift" }
    return names[value.Name] or value.Name
end

local function call(callback, ...)
    if type(callback) ~= "function" then return end
    local ok, message = pcall(callback, ...)
    if not ok then warn("[SableUI] Callback: " .. tostring(message)) end
end

function Window:_connect(signal, callback)
    local connection = signal:Connect(callback)
    self._connections[#self._connections + 1] = connection
    return connection
end

function Window:_tween(object, properties, duration)
    local previous = self._tweens[object]
    if previous then previous:Cancel() end
    local tween = TweenService:Create(object, TweenInfo.new(duration or 0.14, Enum.EasingStyle.Quad), properties)
    self._tweens[object] = tween
    tween:Play()
    return tween
end

function Window:_accent(object, property)
    self._accents[object] = property
    object[property] = self.Theme.Accent
end

function Window:SetAccent(color)
    assert(typeof(color) == "Color3", "Accent must be a Color3")
    self.Theme.Accent = color
    for object, property in pairs(self._accents) do
        if object.Parent then object[property] = color end
    end
    for _, tab in ipairs(self.Tabs) do tab:_paint() end
    for _, control in ipairs(self.Controls) do
        if control._paint then control:_paint() end
    end
end

function Window:_drag(handle, target)
    handle.Active = true
    self:_connect(handle.InputBegan, function(input)
        if not isPointer(input) or self._dead then return end
        self:_closePopup()
        local start, position = pointer(input), target.Position
        self._dragging = { Input = input, Update = function(point)
            local delta = (point - start) / self.Scale.Scale
            local x = math.clamp(position.X.Offset + delta.X, 0, math.max(0, self.Stage.Size.X.Offset - target.Size.X.Offset))
            local y = math.clamp(position.Y.Offset + delta.Y, 0, math.max(0, self.Stage.Size.Y.Offset - 30))
            target.Position = UDim2.fromOffset(x, y)
        end }
    end)
end

function Window:_track(handle, callback)
    self:_connect(handle.InputBegan, function(input)
        if not isPointer(input) then return end
        self._dragging = { Input = input, Update = callback }
        callback(pointer(input))
    end)
end

function Window:_surface(name, title, position, size)
    local shell = make("Frame", {
        Name = name, Position = position, Size = size, BackgroundTransparency = 1,
    }, self.Stage)
    -- Two soft borders, rather than an expensive blur effect or shadow texture.
    for index = 1, 2 do
        local shadow = make("Frame", {
            BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.88,
            BorderSizePixel = 0, Position = UDim2.fromOffset(-index * 3, index),
            Size = UDim2.new(1, index * 6, 1, index * 4), ZIndex = 1,
        }, shell)
        corner(shadow, 5 + index)
    end
    local body = make("Frame", {
        Name = "Body", BackgroundColor3 = self.Theme.Background, BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1), ZIndex = 2, Active = true,
    }, shell)
    corner(body, 4)
    stroke(body, self.Theme.Border, 0.2)
    local header = make("Frame", {
        Name = "Header", BackgroundColor3 = self.Theme.Header, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 30),
    }, body)
    corner(header, 4)
    make("Frame", {
        BackgroundColor3 = self.Theme.Header, BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(1, 0, 0, 4),
    }, header)
    local heading = label(header, title, 13, self.Theme.Text, {
        Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0),
    })
    self:_drag(header, shell)
    self._positions[shell] = position
    return shell, body, header, heading
end

function Window:_closePopup()
    if self._popup then
        self._popup.Frame.Visible = false
        self._popup = nil
    end
end

function Window:_placePopup(popup, anchor)
    local scale = self.Scale.Scale
    local at = (anchor.AbsolutePosition - self.Stage.AbsolutePosition) / scale
    local below = at.Y + anchor.AbsoluteSize.Y / scale + 5
    local width, height = popup.Size.X.Offset, popup.Size.Y.Offset
    local x = math.clamp(at.X, 4, math.max(4, self.Stage.Size.X.Offset - width - 4))
    if below + height > self.Stage.Size.Y.Offset - 4 then below = at.Y - height - 5 end
    popup.Position = UDim2.fromOffset(x, math.max(4, below))
end

function Window:_openPopup(popup, anchor)
    if self._popup and self._popup.Frame == popup then self:_closePopup() return end
    self:_closePopup()
    self:_placePopup(popup, anchor)
    self._popup = { Frame = popup, Anchor = anchor }
    popup.Visible = true
end

function Window:_popupFrame(width, height)
    local frame = make("Frame", {
        Name = "Popup", Visible = false, Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = self.Theme.Header, BorderSizePixel = 0, ZIndex = 50, Active = true,
    }, self.Stage)
    corner(frame, 3)
    stroke(frame, self.Theme.Border)
    return frame
end

function Library:CreateWindow(options)
    options = options or {}
    assert(RunService:IsClient(), "SableUI must run inside the Roblox client.")
    local parent = options.Parent or Players.LocalPlayer:WaitForChild("PlayerGui")
    local id = options.Id or "SableUI"
    local previous = parent:FindFirstChild(id)
    if previous and previous:IsA("ScreenGui") then previous:Destroy() end
    local self = setmetatable({
        Theme = table.clone(Theme), Tabs = {}, Controls = {}, Flags = {},
        _connections = {}, _accents = setmetatable({}, { __mode = "k" }),
        _tweens = setmetatable({}, { __mode = "k" }), _positions = {}, _byFlag = {},
        _bindings = {}, _rainbows = {}, _notices = {}, _dead = false,
        ToggleKey = keycode(options.ToggleKey) or Enum.KeyCode.RightShift,
        _elapsed = 0, _frames = 0, _time = 0, _size = Vector2.new(1120, 560),
    }, Window)
    for name, value in pairs(options.Theme or {}) do
        if self.Theme[name] and typeof(value) == "Color3" then self.Theme[name] = value end
    end
    if options.Accent then self.Theme.Accent = options.Accent end
    self.Gui = make("ScreenGui", {
        Name = id, ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = options.DisplayOrder or 40,
    }, parent)
    self.Stage = make("Frame", {
        Name = "Workspace", AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(1120, 560),
        BackgroundTransparency = 1, BorderSizePixel = 0,
    }, self.Gui)
    self.Scale = make("UIScale", { Scale = 1 }, self.Stage)
    self._userScale = options.Scale or 1
    local surface, body, header, title = self:_surface("Window", "", UDim2.fromOffset(290, 65), UDim2.fromOffset(520, 480))
    self.Frame, self.Body = surface, body
    header.Size = UDim2.new(1, 0, 0, 48)
    local logo = label(header, "S", 31, self.Theme.Accent, {
        Position = UDim2.fromOffset(12, 3), Size = UDim2.fromOffset(25, 40), Font = Enum.Font.Garamond,
    })
    self:_accent(logo, "TextColor3")
    title.Text = options.Title or "Sable"
    title.Position = UDim2.fromOffset(43, 7)
    title.Size = UDim2.new(1, -115, 0, 18)
    self:_accent(title, "TextColor3")
    self.Subtitle = label(header, options.Subtitle or "Interface library", 12, self.Theme.Muted, {
        Position = UDim2.fromOffset(43, 24), Size = UDim2.new(1, -115, 0, 17),
    })
    local minimize = button(header, "−", { Position = UDim2.new(1, -55, 0, 12), Size = UDim2.fromOffset(22, 22), TextColor3 = self.Theme.Muted })
    local close = button(header, "×", { Position = UDim2.new(1, -29, 0, 12), Size = UDim2.fromOffset(22, 22), TextColor3 = self.Theme.Muted })
    self:_connect(minimize.Activated, function() self:Toggle() end)
    self:_connect(close.Activated, function() self:Toggle() end)
    self.TabBar = make("ScrollingFrame", {
        BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(12, 55),
        Size = UDim2.new(1, -24, 0, 31), CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollBarThickness = 0,
        ScrollingDirection = Enum.ScrollingDirection.X,
    }, body)
    make("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.TabBar)
    self.Pages = make("Frame", {
        Name = "Pages", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 96),
        Size = UDim2.new(1, -24, 1, -108), ClipsDescendants = true,
    }, body)
    self.Notifications = make("Frame", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 310),
        Size = UDim2.fromOffset(235, 100), ZIndex = 70,
    }, self.Stage)
    stack(self.Notifications, 7).VerticalAlignment = Enum.VerticalAlignment.Bottom
    self.Reopen = button(self.Gui, (options.Title or "Sable") .. "  ·  Open", {
        Visible = false, BackgroundColor3 = self.Theme.Header, TextColor3 = self.Theme.Accent,
        Position = UDim2.new(0, 12, 0.5, -17), Size = UDim2.fromOffset(112, 34),
    })
    corner(self.Reopen, 4)
    stroke(self.Reopen, self.Theme.Border)
    self:_connect(self.Reopen.Activated, function() self:SetVisible(true) end)
    if options.MascotImage and options.MascotImage ~= "" then
        self.Mascot = make("ImageLabel", {
            Name = "Mascot", BackgroundTransparency = 1, Image = options.MascotImage,
            ScaleType = Enum.ScaleType.Fit, Position = UDim2.new(1, -158, 0, -62),
            Size = UDim2.fromOffset(200, 205), ZIndex = 10,
        }, surface)
    end
    self:_connect(Input.InputBegan, function(input, processed)
        if self._dead then return end
        if self._capturing then
            local binding = self._capturing
            if input.UserInputType == Enum.UserInputType.Keyboard then
                self._capturing = nil
                if input.KeyCode == Enum.KeyCode.Escape then binding:_paint()
                elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then binding:Set(Enum.KeyCode.Unknown)
                else binding:Set(input.KeyCode) end
            end
            return
        end
        if isPointer(input) and self._popup and not inside(self._popup.Frame, pointer(input)) and not inside(self._popup.Anchor, pointer(input)) then
            self:_closePopup()
        end
        if processed or Input:GetFocusedTextBox() then return end
        if input.KeyCode == self.ToggleKey then self:Toggle() return end
        for _, binding in ipairs(self._bindings) do
            if not binding.Disabled and not (binding.Target and binding.Target.Disabled) and binding.Value ~= Enum.KeyCode.Unknown and input.KeyCode == binding.Value then
                if binding.Mode == "Hold" then binding.Active = true
                elseif binding.Mode == "Toggle" then binding.Active = not binding.Active end
                if binding.Target then binding.Target:Set(not binding.Target.Value) end
                call(binding.Callback, binding.Mode == "Press" or binding.Active, binding.Value)
                self:_refreshKeybinds()
            end
        end
    end)
    self:_connect(Input.InputChanged, function(input)
        local drag = self._dragging
        if drag and (input == drag.Input or (drag.Input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then
            drag.Update(pointer(input))
        end
    end)
    self:_connect(Input.InputEnded, function(input)
        local drag = self._dragging
        if drag and (input == drag.Input or input.UserInputType == Enum.UserInputType.MouseButton1) then self._dragging = nil end
        for _, binding in ipairs(self._bindings) do
            if binding.Mode == "Hold" and binding.Active and input.KeyCode == binding.Value then
                binding.Active = false
                call(binding.Callback, false, binding.Value)
                self:_refreshKeybinds()
            end
        end
    end)
    self:_connect(Input.WindowFocusReleased, function()
        self._dragging = nil
        for _, binding in ipairs(self._bindings) do
            if binding.Mode == "Hold" and binding.Active then binding.Active = false call(binding.Callback, false, binding.Value) end
        end
        self:_refreshKeybinds()
    end)
    self:_connect(RunService.RenderStepped, function(dt)
        self._elapsed += dt
        self._frames += 1
        self._time += dt
        local camera = workspace.CurrentCamera
        if camera then
            local viewport = camera.ViewportSize
            local scale = math.min((viewport.X - 16) / self._size.X, (viewport.Y - 16) / self._size.Y, self._userScale)
            self.Scale.Scale = math.max(0.1, scale)
        end
        if self._elapsed >= 0.5 then
            self.FPS = math.floor(self._frames / self._elapsed + 0.5)
            self._frames, self._elapsed = 0, 0
            if self.Watermark then self.Watermark:_update() end
        end
        -- One shared clock; no threads or connections are created per update.
        if self._time >= 1 / 30 then
            self._time = 0
            for control in pairs(self._rainbows) do control:_rainbowStep() end
        end
        for index = #self._notices, 1, -1 do
            local notice = self._notices[index]
            notice.Time -= dt
            if notice.Time <= 0 then
                self._tweens[notice.Frame] = nil
                notice.Frame:Destroy()
                table.remove(self._notices, index)
            elseif notice.Time < 0.3 and not notice.Fading then
                notice.Fading = true
                self:_tween(notice.Frame, { GroupTransparency = 1 }, 0.25)
            end
        end
    end)
    self:_connect(self.Gui.Destroying, function() self:_cleanup() end)
    return self
end

function Window:SetVisible(visible)
    visible = visible == true
    self.Stage.Visible = visible
    self.Reopen.Visible = not visible
    self._dragging = nil
    self:_closePopup()
end

function Window:Toggle() self:SetVisible(not self.Stage.Visible) end
function Window:SetSubtitle(text) self.Subtitle.Text = tostring(text) end
function Window:SetScale(scale) assert(finite(scale) and scale > 0, "Scale must be positive") self._userScale = math.clamp(scale, 0.4, 2) end

function Window:ResetPositions()
    self:_closePopup()
    for object, position in pairs(self._positions) do if object.Parent then object.Position = position end end
end

function Window:_cleanup()
    if self._dead then return end
    self._dead = true
    for _, connection in ipairs(self._connections) do connection:Disconnect() end
    for _, tween in pairs(self._tweens) do tween:Cancel() end
    for _, binding in ipairs(self._bindings) do
        if binding.Mode == "Hold" and binding.Active then call(binding.Callback, false, binding.Value) end
    end
    table.clear(self._connections)
    table.clear(self._rainbows)
    table.clear(self._notices)
    table.clear(self._bindings)
    table.clear(self._tweens)
    table.clear(self._accents)
    table.clear(self._positions)
    table.clear(self._byFlag)
    table.clear(self.Flags)
    table.clear(self.Controls)
    table.clear(self.Tabs)
    self._dragging, self._popup, self._capturing = nil, nil, nil
end

function Window:Destroy()
    self:_cleanup()
    if self.Gui then self.Gui:Destroy() end
end

function Window:Tab(options)
    options = type(options) == "string" and { Name = options } or options or {}
    local tab = setmetatable({ Window = self, Name = options.Name or "Tab", Hidden = options.Hidden == true }, Tab)
    tab.Button = button(self.TabBar, "", {
        Size = UDim2.fromOffset(options.Width or 91, 29), Visible = not tab.Hidden,
        LayoutOrder = #self.Tabs + 1,
    })
    corner(tab.Button, 3)
    tab.Icon = label(tab.Button, options.Icon or "◉", 15, self.Theme.Muted, { Position = UDim2.fromOffset(7, 0), Size = UDim2.fromOffset(19, 29) })
    tab.Title = label(tab.Button, tab.Name, 14, self.Theme.Muted, { Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -30, 1, 0) })
    tab.Page = make("ScrollingFrame", {
        Name = tab.Name, BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
        Size = UDim2.fromScale(1, 1), ScrollBarThickness = 2, ScrollBarImageColor3 = self.Theme.Accent,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
    }, self.Pages)
    tab.Columns = {}
    self:_connect(tab.Page:GetPropertyChangedSignal("CanvasPosition"), function() self:_closePopup() end)
    for index, side in ipairs({ "Left", "Right" }) do
        local column = make("Frame", {
            Name = side, BackgroundTransparency = 1, Size = UDim2.new(0.5, -7, 0, 0),
            Position = UDim2.new((index - 1) * 0.5, index == 1 and 0 or 5, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
        }, tab.Page)
        stack(column, 10)
        tab.Columns[side] = column
    end
    self.Tabs[#self.Tabs + 1] = tab
    self:_connect(tab.Button.Activated, function() self:SelectTab(tab) end)
    if not self.SelectedTab and not tab.Hidden then self:SelectTab(tab) end
    return tab
end

function Tab:_paint()
    local selected = self.Window.SelectedTab == self
    self.Button.BackgroundColor3 = self.Window.Theme.Header
    self.Button.BackgroundTransparency = selected and 0 or 1
    self.Title.TextColor3 = selected and self.Window.Theme.Text or self.Window.Theme.Muted
    self.Icon.TextColor3 = selected and self.Window.Theme.Accent or self.Window.Theme.Muted
    self.Page.Visible = selected
end

function Tab:SetHidden(hidden) self.Hidden = hidden == true self.Button.Visible = not self.Hidden end

function Window:SelectTab(tab)
    if type(tab) == "number" then tab = self.Tabs[tab] end
    if type(tab) == "string" then
        for _, candidate in ipairs(self.Tabs) do if candidate.Name == tab then tab = candidate break end end
    end
    assert(type(tab) == "table" and tab.Window == self, "SelectTab expects a tab from this window")
    self:_closePopup()
    self.SelectedTab = tab
    for _, candidate in ipairs(self.Tabs) do candidate:_paint() end
end

function Tab:Section(options)
    options = type(options) == "string" and { Name = options } or options or {}
    local section = setmetatable({ Window = self.Window, Tab = self, _order = 0 }, Section)
    local column = self.Columns[options.Side or "Left"]
    assert(column, "Section.Side must be Left or Right")
    section.Frame = make("Frame", {
        Name = options.Name or "Section", BackgroundColor3 = self.Window.Theme.Section,
        BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = #column:GetChildren(),
    }, column)
    corner(section.Frame, 3)
    stroke(section.Frame, self.Window.Theme.Border, 0.65)
    pad(section.Frame, 10)
    stack(section.Frame, 6)
    label(section.Frame, options.Name or "Section", 14, self.Window.Theme.Text, { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 20) })
    return section
end

function Section:_row(height)
    self._order += 1
    return make("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height), LayoutOrder = self._order,
    }, self.Frame)
end

function Section:_control(options, kind, row)
    local window = self.Window
    local control = { Window = window, Frame = row, Type = kind, Flag = options.Flag, Callback = options.Callback, Disabled = options.Disabled == true }
    if control.Flag then
        assert(type(control.Flag) == "string" and not window._byFlag[control.Flag], "Flags must be unique strings: " .. tostring(control.Flag))
        window._byFlag[control.Flag] = control
    end
    function control:_publish(silent)
        if self.Flag then window.Flags[self.Flag] = copy(self.Value) end
        if not silent then call(self.Callback, copy(self.Value)) end
    end
    function control:Get() return copy(self.Value) end
    function control:SetVisible(value) row.Visible = value == true window:_closePopup() end
    function control:SetDisabled(value)
        self.Disabled = value == true
        if self._paint then self:_paint() end
    end
    window.Controls[#window.Controls + 1] = control
    return control
end

