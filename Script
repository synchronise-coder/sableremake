    corner(composer, 2)
    stroke(composer, self.Theme.Border, 0.7)
    line(composer, Vector2.new(9, 17), Vector2.new(16, 8), self.Theme.Muted, 3)
    local input = field(composer, "", {
        BackgroundTransparency = 1, PlaceholderText = "Type here...", Position = UDim2.fromOffset(22, 0),
