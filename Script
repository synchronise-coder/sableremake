function Window:_refreshKeybinds()
    if not self.KeybindPanel then return end
    local widget = self.KeybindPanel
    local visible = 0
    for index, binding in ipairs(self._bindings) do
        local item = widget.Rows[index]
        if not item then
            item = button(widget.List, "", { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = index })
            label(item, binding.Name, 13, self.Theme.Text, { Name = "BindingName", Size = UDim2.new(1, -34, 1, 0) })
            label(item, "", 13, self.Theme.Muted, { Name = "BindingKey", Position = UDim2.new(1, -32, 0, 0), Size = UDim2.fromOffset(32, 20), TextXAlignment = Enum.TextXAlignment.Right })
            item.Activated:Connect(function() binding:_capture() end)
            widget.Rows[index] = item
        end
        local active = binding.Active
        if binding.Target then active = binding.Target.Value end
        item.BindingName.TextColor3 = active and self.Theme.Accent or self.Theme.Text
        item.BindingKey.Text = keyname(binding.Value)
        item.Visible = not widget.ActiveOnly or active == true
        if item.Visible then visible += 1 end
    end
    widget.Empty.Visible = visible == 0
    widget.Frame.Size = UDim2.fromOffset(widget.Width, 39 + math.min(math.max(1, visible), 8) * 20)
end

