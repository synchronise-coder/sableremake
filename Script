    flags.TextWrapped = true
    local healthBar = make("Frame", { Name = "Health", Visible = false, BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Size = UDim2.fromOffset(2, 116), ZIndex = 5 }, overlay)
    local healthFill = make("Frame", { BackgroundColor3 = self.Theme.Text, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 1) }, healthBar)
    local health = caption("100", 24, 12, Enum.TextXAlignment.Right, self.Theme.Muted)
    local distance = caption(options.Distance or "100st", 100, 11)
    local weapon = caption(options.Weapon or "None", 100, 11, nil, self.Theme.Muted)
    local loading = label(body, "Loading your character...", 13, self.Theme.Muted, { Position = UDim2.new(0, 8, 0.5, -10), Size = UDim2.new(1, -16, 0, 20), TextXAlignment = Enum.TextXAlignment.Center })
    local widget = {
        Frame = frame, Viewport = view, Camera = camera, Model = nil, Box = box, Glow = glowAnchor, Angle = 0,
        Rotating = options.Rotate ~= false, RotationSpeed = options.RotationSpeed or 20, Zoom = options.Zoom or 1,
        BoxEnabled = options.Box ~= false, SkeletonEnabled = options.Skeleton ~= false, GlowEnabled = options.Glow ~= false,
        AutoHealth = options.AutoHealth ~= false, NeutralPose = options.NeutralPose ~= false, _followLocal = options.LocalPlayer ~= false,
        _characterConnections = {}, _bones = {}, _clock = 0, _manualUntil = 0, _viewWidth = 178, _viewHeight = 163, _healthFraction = 1,
    }
    local boneNames = {
        { "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
        { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
        { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
        { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
        { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
        { "Head", "Torso" }, { "Torso", "Left Arm" }, { "Torso", "Right Arm" }, { "Torso", "Left Leg" }, { "Torso", "Right Leg" },
    }
    function widget:SetVisible(visible) frame.Visible = visible == true end
    function widget:SetBox(visible) self.BoxEnabled = visible == true box.Visible = self.BoxEnabled and self.Model ~= nil end
    function widget:SetGlow(visible) self.GlowEnabled = visible == true glowAnchor.Visible = self.GlowEnabled and self.Model ~= nil end
    function widget:SetSkeleton(visible) self.SkeletonEnabled = visible == true skeleton.Visible = self.SkeletonEnabled end
    function widget:SetName(text) name.Text = tostring(text) end
    function widget:SetFlags(text) flags.Text = tostring(text) end
    function widget:SetDistance(text) distance.Text = tostring(text) end
    function widget:SetWeapon(text) weapon.Text = tostring(text) end
    function widget:SetRotating(enabled) self.Rotating = enabled == true end
    function widget:SetRotationSpeed(degrees) assert(finite(degrees), "Rotation speed must be a number") self.RotationSpeed = math.clamp(degrees, -180, 180) end
    function widget:SetHealth(value, maximum)
        maximum = maximum or 100
        assert(finite(value) and finite(maximum) and maximum > 0, "Health and maximum must be finite; maximum must be positive")
        self._healthFraction = math.clamp(value / maximum, 0, 1)
        health.Text = tostring(math.round(math.max(0, value)))
        healthFill.Size = UDim2.fromScale(1, self._healthFraction)
    end
    function widget:SetColor(color) outline.Color = color name.TextColor3 = color end
    function widget:_disconnectCharacter()
        for _, connection in ipairs(self._characterConnections) do connection:Disconnect() end
        table.clear(self._characterConnections)
        if self._healthConnection then self._healthConnection:Disconnect() self._healthConnection = nil end
        if self._maxHealthConnection then self._maxHealthConnection:Disconnect() self._maxHealthConnection = nil end
        self._humanoid = nil
    end
    function widget:_bindHealth()
        local humanoid = self.Source and self.Source:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid == self._humanoid then return end
        if self._healthConnection then self._healthConnection:Disconnect() end
        if self._maxHealthConnection then self._maxHealthConnection:Disconnect() end
        self._humanoid = humanoid
        local function update() if self.AutoHealth then self:SetHealth(humanoid.Health, math.max(1, humanoid.MaxHealth)) end end
        self._healthConnection = humanoid.HealthChanged:Connect(update)
        self._maxHealthConnection = humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(update)
        update()
    end
    function widget:_fit()
        if not self.BoundsSize then return end
        local size = self.BoundsSize
        local focal = self._viewHeight / (2 * math.tan(math.rad(camera.FieldOfView) / 2))
        local radius = math.sqrt(size.X * size.X + size.Z * size.Z) / 2
        local desiredHeight = self._viewHeight * math.clamp(0.66 * self.Zoom, 0.35, 0.9)
        local desiredWidth = self._viewWidth * math.clamp(0.56 * self.Zoom, 0.3, 0.78)
        self.Range = math.max(size.Y * focal / desiredHeight, radius * 2 * focal / desiredWidth) + radius * 0.5
    end
    function widget:_layout()
        self._viewWidth = math.max(100, frame.Size.X.Offset - 40)
        self._viewHeight = math.max(110, frame.Size.Y.Offset - 78)
        view.Size = UDim2.fromOffset(self._viewWidth, self._viewHeight)
        overlay.Position, overlay.Size = view.Position, view.Size
        self:_fit()
        self:_draw()
    end
    function widget:SetZoom(value)
        assert(finite(value), "Zoom must be a number")
        self.Zoom = math.clamp(value, 0.6, 1.35)
        self:_fit() self:_draw()
    end
    function widget:_loadModel(model)
        local archivable = model.Archivable
        local ok, clone = pcall(function() model.Archivable = true return model:Clone() end)
        pcall(function() model.Archivable = archivable end)
        if not ok or not clone then return false, "Could not clone character" end
        local parts, joints = {}, {}
        for _, object in ipairs(clone:GetDescendants()) do
            if object:IsA("BaseScript") or object:IsA("ModuleScript") or object:IsA("Tool")
                or object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam")
                or object:IsA("BillboardGui") or object:IsA("SurfaceGui") then object:Destroy()
            elseif object:IsA("BasePart") then
                object.Anchored, object.CanCollide, object.LocalTransparencyModifier = true, false, 0
                parts[#parts + 1] = object
            elseif object:IsA("Motor6D") or object:IsA("Weld") then joints[#joints + 1] = object end
        end
        if not clone:FindFirstChildWhichIsA("BasePart", true) then clone:Destroy() return false, "Character has no parts yet" end
        clone:PivotTo(CFrame.new())
        if self.NeutralPose then
            local root = clone:FindFirstChild("HumanoidRootPart") or clone.PrimaryPart
            local posed = root and { [root] = true } or {}
            for _, joint in ipairs(joints) do if joint:IsA("Motor6D") then joint.Transform = CFrame.new() end end
            -- Restore the rig's resting joints on the copy, including accessory welds.
            for pass = 1, #joints do
                local changed = false
                for _, joint in ipairs(joints) do
                    local first, second = joint.Part0, joint.Part1
                    if first and second then
                        if posed[first] and not posed[second] then
                            second.CFrame = first.CFrame * joint.C0 * joint.C1:Inverse()
                            posed[second], changed = true, true
                        elseif posed[second] and not posed[first] then
                            first.CFrame = second.CFrame * joint.C1 * joint.C0:Inverse()
                            posed[first], changed = true, true
                        end
                    end
                end
                if not changed then break end
            end
        end
        local bodyParts = {}
        for _, part in ipairs(parts) do
            if part.Parent == clone and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then bodyParts[#bodyParts + 1] = part end
        end
        if #bodyParts == 0 then for _, part in ipairs(parts) do if part.Parent and part.Transparency < 1 then bodyParts[#bodyParts + 1] = part end end end
        if #bodyParts == 0 then clone:Destroy() return false, "Character has no visible parts" end
        local points = {}
        local low, high = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
        for _, part in ipairs(bodyParts) do
            for _, x in ipairs({ -0.5, 0.5 }) do for _, y in ipairs({ -0.5, 0.5 }) do for _, z in ipairs({ -0.5, 0.5 }) do
                local point = part.CFrame:PointToWorldSpace(Vector3.new(part.Size.X * x, part.Size.Y * y, part.Size.Z * z))
                points[#points + 1] = point
                low = Vector3.new(math.min(low.X, point.X), math.min(low.Y, point.Y), math.min(low.Z, point.Z))
                high = Vector3.new(math.max(high.X, point.X), math.max(high.Y, point.Y), math.max(high.Z, point.Z))
            end end end
        end
        if self.Model then self.Model:Destroy() end
        for _, bone in ipairs(self._bones) do bone.Line:Destroy() bone.Shadow:Destroy() end
        table.clear(self._bones)
        clone.Parent = world
        self.Model, self._corners, self.BoundsSize, self.Center = clone, points, high - low, (high + low) * 0.5
        self.Bounds = CFrame.new(self.Center)
        for _, names in ipairs(boneNames) do
            local first, second = clone:FindFirstChild(names[1], true), clone:FindFirstChild(names[2], true)
            if first and second and first:IsA("BasePart") and second:IsA("BasePart") then
                local shadow = line(skeleton, Vector2.new(), Vector2.new(), Color3.new(0, 0, 0), 2)
                shadow.BackgroundTransparency = 0.45
                local mark = line(skeleton, Vector2.new(), Vector2.new(), Color3.fromRGB(194, 192, 201), 1)
                mark.BackgroundTransparency = 0.2
                self._bones[#self._bones + 1] = { A = first, B = second, Line = mark, Shadow = shadow, Marks = { shadow, mark } }
            end
        end
        loading.Visible = false
        name.Visible, flags.Visible, healthBar.Visible, health.Visible, distance.Visible, weapon.Visible = true, true, true, true, true, true
        box.Visible, glowAnchor.Visible = self.BoxEnabled, self.GlowEnabled
        self:_layout()
        return true
    end
    function widget:_project(position)
        local point = camera.CFrame:PointToObjectSpace(position)
        local focal = self._viewHeight / (2 * math.tan(math.rad(camera.FieldOfView) / 2))
        local depth = math.max(0.01, -point.Z)
        return Vector2.new(self._viewWidth / 2 + point.X / depth * focal, self._viewHeight / 2 - point.Y / depth * focal)
    end
    function widget:_draw()
        if not self.Model then return end
        camera.CFrame = CFrame.lookAt(self.Center + Vector3.new(math.sin(self.Angle) * self.Range, 0, -math.cos(self.Angle) * self.Range), self.Center)
        local left, top, right, bottom = math.huge, math.huge, -math.huge, -math.huge
        for _, point in ipairs(self._corners) do
            local pixel = self:_project(point)
            left, top, right, bottom = math.min(left, pixel.X), math.min(top, pixel.Y), math.max(right, pixel.X), math.max(bottom, pixel.Y)
        end
        left, top = math.floor(left - 2), math.floor(top - 2)
        local width, height = math.ceil(right + 2 - left), math.ceil(bottom + 2 - top)
        box.Position, box.Size = UDim2.fromOffset(left, top), UDim2.fromOffset(width, height)
        glowAnchor.Position, glowAnchor.Size = box.Position, box.Size
        name.Position = UDim2.fromOffset(left + width / 2 - 74, top - 12)
        flags.Position = UDim2.fromOffset(left + width + 5, top)
        healthBar.Position, healthBar.Size = UDim2.fromOffset(left - 5, top), UDim2.fromOffset(2, height)
        health.Position = UDim2.fromOffset(left - 32, top + height * (1 - self._healthFraction) - 5)
        distance.Position = UDim2.fromOffset(left + width / 2 - 50, top + height + 3)
        weapon.Position = UDim2.fromOffset(left + width / 2 - 50, top + height + 13)
        if self.SkeletonEnabled then
            for _, bone in ipairs(self._bones) do
                local first, second = self:_project(bone.A.Position), self:_project(bone.B.Position)
                local delta = second - first
                for _, mark in ipairs(bone.Marks) do
                    mark.Position = UDim2.fromOffset((first.X + second.X) / 2, (first.Y + second.Y) / 2)
                    mark.Size = UDim2.fromOffset(delta.Magnitude, mark == bone.Line and 1 or 2)
                    mark.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                end
            end
        end
    end
    function widget:_refreshCharacter()
        self._refreshAt = nil
        if window._dead or not self._followLocal or not self.Source or self.Source ~= player.Character then return end
        local ok, message = self:_loadModel(self.Source)
        if not ok and not self.Model then loading.Text = message end
        self:_bindHealth()
    end
    function widget:_watchCharacter(character)
        self:_disconnectCharacter()
        self.Source = character
        if not character then return end
        local function changed(object)
            if object:IsA("BasePart") or object:IsA("Accessory") or object:IsA("Shirt") or object:IsA("Pants") or object:IsA("BodyColors") or object:IsA("Humanoid") then self._refreshAt = os.clock() + 0.25 end
        end
        self._characterConnections[#self._characterConnections + 1] = character.DescendantAdded:Connect(changed)
        self._characterConnections[#self._characterConnections + 1] = character.DescendantRemoving:Connect(changed)
        self:_refreshCharacter()
    end
    function widget:UseLocalPlayer()
        self._followLocal = true
        self:SetName(options.Name or player.DisplayName)
        self:_watchCharacter(player.Character)
    end
    function widget:Refresh() if self._followLocal then self:_watchCharacter(player.Character) end end
    function widget:SetModel(model)
        assert(typeof(model) == "Instance" and model:IsA("Model"), "SetModel expects a Model")
        local ok, message = self:_loadModel(model)
        if ok then self._followLocal = false self:_disconnectCharacter() self.Source = nil end
        return ok, message
    end
    function widget:_step(dt)
        if self._refreshAt and os.clock() >= self._refreshAt then self:_refreshCharacter() end
        self._clock += dt
        if self._clock < 1 / 60 then return end
        local elapsed = self._clock
        self._clock = 0
        if not frame.Visible or not window.Stage.Visible or not self.Model then return end
        if self.Rotating and os.clock() >= self._manualUntil then self.Angle = (self.Angle + math.rad(self.RotationSpeed) * math.min(elapsed, 0.1)) % (math.pi * 2) end
        self:_draw()
    end
    function widget:_cleanup()
        self:_disconnectCharacter()
        self._refreshAt, self.Source = nil, nil
        table.clear(self._bones)
        self._corners = nil
    end
    widget.Resizer = self:_enableResize(frame, { Enabled = options.Resizable ~= false, MinSize = Vector2.new(180, 210), MaxSize = Vector2.new(560, 640) })
    function widget:SetSize(width, height) self.Resizer:SetSize(width, height) end
    function widget:SetResizable(enabled) self.Resizer:SetEnabled(enabled) end
    self:_connect(frame:GetPropertyChangedSignal("Size"), function() widget:_layout() end)
    self:_connect(view.InputBegan, function(event)
        if not isPointer(event) or self._resizingInput == event then return end
        self:_bringToFront(frame)
        local start, angle = pointer(event), widget.Angle
        self._dragging = { Input = event, Update = function(point)
            widget.Angle = angle + (point.X - start.X) / window.Scale.Scale / 90
            widget._manualUntil = os.clock() + 1.5
            widget:_draw()
        end }
    end)
    self:_connect(view.InputChanged, function(event)
        if event.UserInputType == Enum.UserInputType.MouseWheel then widget:SetZoom(widget.Zoom + event.Position.Z * 0.08) end
    end)
    self:_connect(player.CharacterAdded, function(character) if widget._followLocal then widget:_watchCharacter(character) end end)
    self:_connect(player.CharacterAppearanceLoaded, function(character)
        if widget._followLocal and character == player.Character then widget._refreshAt = os.clock() + 0.1 end
    end)
    self.Preview = widget
    widget:_layout()
    if widget._followLocal then widget:UseLocalPlayer() end
    return widget
end

-- Configs contain data only. Import validates everything before changing controls.
function Window:ExportConfig()
    local values = {}
    for flag, control in pairs(self._byFlag) do
        if control.Type == "Colorpicker" then
            values[flag] = { Type = control.Type, Value = control.Value:ToHex(), Alpha = control.Alpha, Rainbow = control.Rainbow, AlphaEnabled = control.AlphaEnabled }
        elseif control.Type == "Keybind" then
            values[flag] = { Type = control.Type, Value = control.Value.Name }
        elseif control.Type ~= "Button" then
            values[flag] = { Type = control.Type, Value = copy(control.Value) }
        end
    end
    return HttpService:JSONEncode({ Version = 1, Values = values })
end

function Window:ImportConfig(json, silent)
    if type(json) ~= "string" or #json > 1024 * 1024 then return false, "Config must be JSON under 1 MB" end
    local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(data) ~= "table" or data.Version ~= 1 or type(data.Values) ~= "table" then return false, "Invalid SableUI config" end
    local changes = {}
    for flag, entry in pairs(data.Values) do
        local control = self._byFlag[flag]
        if control then
            if type(entry) ~= "table" or entry.Type ~= control.Type then return false, "Wrong control type: " .. flag end
            local value, valid = entry.Value, false
            if control.Type == "Toggle" then valid = type(value) == "boolean"
            elseif control.Type == "Slider" then valid = finite(value)
            elseif control.Type == "Input" then valid = type(value) == "string"
            elseif control.Type == "Keybind" then valid = keycode(value) ~= nil
            elseif control.Type == "Colorpicker" then
                valid = type(value) == "string" and value:match("^%x%x%x%x%x%x$") ~= nil and finite(entry.Alpha) and type(entry.Rainbow) == "boolean"
                    and (entry.AlphaEnabled == nil or type(entry.AlphaEnabled) == "boolean")
            elseif control.Type == "Dropdown" then
                if control.Multi then
                    valid = type(value) == "table"
                    if valid then
                        local count = 0
                        for index, item in pairs(value) do
                            count += 1
                            if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > #value or not table.find(control.Values, item) then valid = false break end
                        end
                        valid = valid and count == #value
                    end
                else valid = value == nil or table.find(control.Values, value) ~= nil end
            end
            if not valid then return false, "Invalid value: " .. flag end
            changes[control] = entry
        end
    end
    -- Stable creation order makes callbacks predictable, including theme controls.
    for _, control in ipairs(self.Controls) do
        local entry = changes[control]
        if entry then
            if control.Type == "Colorpicker" then
                control.AlphaEnabled = entry.AlphaEnabled ~= false
                control._savedAlpha = entry.Alpha
                control:Set(Color3.fromHex(entry.Value), entry.Alpha, true)
                control:SetRainbow(entry.Rainbow, true)
            else control:Set(entry.Value, true) end
        end
    end
    if not silent then
        for _, control in ipairs(self.Controls) do
            if changes[control] then
                if control.Type == "Colorpicker" then call(control.Callback, control.Value, control.Alpha)
                elseif control.Type ~= "Keybind" then call(control.Callback, copy(control.Value)) end
            end
        end
    end
    return true
end

local function configPath(name)
    if type(name) ~= "string" or #name < 1 or #name > 48 or not name:match("^[%w_%-]+$") then return nil end
    return "SableUI_" .. name .. ".json"
end

function Window:SaveConfig(name)
    local path = configPath(name)
    if not path then return false, "Use 1–48 letters, numbers, dashes or underscores" end
    local write = getfenv(0).writefile
    if type(write) ~= "function" then return false, "File saving is unavailable. Use ExportConfig() instead." end
    local ok, message = pcall(function() write(path, self:ExportConfig()) end)
    return ok, ok and path or tostring(message)
end

function Window:LoadConfig(name, silent)
    local path = configPath(name)
    if not path then return false, "Invalid config name" end
    local read = getfenv(0).readfile
    if type(read) ~= "function" then return false, "File loading is unavailable. Use ImportConfig(json) instead." end
    local ok, json = pcall(read, path)
    if not ok then return false, "Could not read " .. path end
    return self:ImportConfig(json, silent)
end

function Window:DeleteConfig(name)
    local path = configPath(name)
    if not path then return false, "Invalid config name" end
    local delete = getfenv(0).delfile
    if type(delete) ~= "function" then return false, "File deletion is unavailable in this environment" end
    local ok, message = pcall(delete, path)
    return ok, ok and "Deleted " .. path or tostring(message)
end

