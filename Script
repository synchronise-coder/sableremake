function Window:CreateChat(options)
    options = options or {}
    if self.Chat then return self.Chat end
    local frame, body, header, heading = self:_surface("Chat", "▣  Chat", UDim2.fromOffset(824, 65), UDim2.fromOffset(246, 298))
    heading.Size = UDim2.fromOffset(80, 30)
    local status = label(header, options.Status or "Local demo", 12, self.Theme.Muted, { Position = UDim2.new(1, -123, 0, 0), Size = UDim2.fromOffset(88, 30), TextXAlignment = Enum.TextXAlignment.Right })
    local dot = make("Frame", { BorderSizePixel = 0, BackgroundColor3 = self.Theme.Muted, Position = UDim2.new(1, -29, 0, 11), Size = UDim2.fromOffset(8, 8) }, header)
    corner(dot, 5)
    local close = button(header, "×", { Position = UDim2.new(1, -18, 0, 0), Size = UDim2.fromOffset(16, 30), TextColor3 = self.Theme.Muted })
    local list = make("ScrollingFrame", {
        BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(10, 37),
        Size = UDim2.new(1, -20, 1, -82), ScrollBarThickness = 2, ScrollBarImageColor3 = self.Theme.Accent,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, body)
    stack(list, 10)
    local input = field(body, "", { PlaceholderText = "Type here...", Position = UDim2.new(0, 10, 1, -35), Size = UDim2.new(1, -49, 0, 25) })
    local send = button(body, "›", { Position = UDim2.new(1, -34, 1, -35), Size = UDim2.fromOffset(25, 25), TextSize = 23, TextColor3 = self.Theme.Accent })
    local widget = { Frame = frame, Messages = {}, Limit = math.clamp(options.MaxMessages or 60, 1, 200), _count = 0 }
    local window = self
    function widget:SetVisible(visible) frame.Visible = visible == true end
    function widget:SetStatus(text, connected)
        status.Text = tostring(text)
        dot.BackgroundColor3 = connected and window.Theme.Success or window.Theme.Muted
    end
    function widget:AddMessage(message)
        if window._dead then return end
        message = message or {}
        self._count += 1
        local row = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -3, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self._count }, list)
        local avatar = make("Frame", { BorderSizePixel = 0, BackgroundColor3 = window.Theme.Header, Position = UDim2.fromOffset(0, 2), Size = UDim2.fromOffset(23, 23) }, row)
        corner(avatar, 12)
        if message.Avatar and message.Avatar ~= "" then
            local picture = make("ImageLabel", { BackgroundTransparency = 1, Image = message.Avatar, Size = UDim2.fromScale(1, 1) }, avatar)
            corner(picture, 12)
        else
            label(avatar, tostring(message.Author or "Other"):sub(1, 1):upper(), 14, window.Theme.Accent, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
        end
        local content = make("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(32, 0), Size = UDim2.new(1, -32, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, row)
        stack(content, 3)
        label(content, tostring(message.Author or "Other"):sub(1, 60), 12, window.Theme.Text, { Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 1 })
        local bubble = make("Frame", { BackgroundColor3 = window.Theme.Control, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 }, content)
        corner(bubble, 3)
        pad(bubble, 6)
        label(bubble, tostring(message.Text or ""):sub(1, 512), 13, window.Theme.Muted, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top })
        self.Messages[#self.Messages + 1] = row
        if #self.Messages > self.Limit then table.remove(self.Messages, 1):Destroy() end
        -- Renumber occasionally so a long-running session keeps even counters bounded.
        if self._count >= 10000 then
            for index, item in ipairs(self.Messages) do item.LayoutOrder = index end
            self._count = #self.Messages
        end
    end
    function widget:Clear()
        for _, row in ipairs(self.Messages) do row:Destroy() end
        table.clear(self.Messages)
        self._count = 0
    end
    local function submit()
        local text = input.Text:match("^%s*(.-)%s*$")
        if text == "" then return end
        input.Text = ""
        -- UI callback only. Connect your own filtered server chat separately.
        if options.OnSend then call(options.OnSend, text:sub(1, 512), widget)
        else widget:AddMessage({ Author = "You", Text = text }) end
    end
    self:_connect(input.FocusLost, function(enter) if enter then submit() end end)
    self:_connect(send.Activated, submit)
    self:_connect(close.Activated, function() widget:SetVisible(false) end)
    self:_connect(list:GetPropertyChangedSignal("AbsoluteCanvasSize"), function()
        list.CanvasPosition = Vector2.new(0, math.max(0, list.AbsoluteCanvasSize.Y - list.AbsoluteSize.Y))
    end)
    self.Chat = widget
    return widget
end

